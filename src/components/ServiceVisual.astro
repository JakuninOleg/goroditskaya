---
import Emblem from './Emblem.astro';
import type { Service } from '../data/services';
interface Props { service: Service; }
const { service } = Astro.props;
const bars = [[25,39,32,54,48,71,84],[62,44,29,45,67,51,80],[37,49,40,62,54,77,69]];
---
<figure class:list={['service-visual','visual-'+service.visual]} aria-label={service.labels.join(' → ')}>
  {service.visual!=='flow'&&<div class="visual-grid" aria-hidden="true"></div>}
  {service.visual==='reports' ? <div class="report-planes">{service.labels.map((label,i)=><div class={'report-plane plane-'+i}><strong>{label}</strong><div class="paper-rules" aria-hidden="true"><i></i><i></i></div><svg viewBox="0 0 180 146" aria-hidden="true"><path d="M8 126h164M8 94h164M8 62h164M8 30h164" stroke="#d9e1d3" fill="none"/>{bars[i].map((v,n)=><rect x={14+n*22} y={125-v} width="13" height={v} rx="2" fill={n===6?'#bc9a4e':'#8caf9b'}/>)}<path d="M8 112C30 110 30 76 50 81S77 101 94 65 120 60 140 42 160 31 174 22" stroke="#315f4c" stroke-width="2.5" fill="none"/></svg><div class="paper-rules bottom-rules" aria-hidden="true"><i></i><i></i><i></i></div></div>)}</div>
  : service.visual==='model' ? <div class="scenario-art"><div class="scenario-title"><Emblem name="clarity"/><strong>{service.labels[0]}</strong></div><div class="scenario-legend"><span>Базовый сценарий</span><span>Рост</span><span>Стресс</span></div><svg viewBox="0 0 520 260" aria-hidden="true"><g stroke="#b4ccbb30"><path d="M20 40h480M20 100h480M20 160h480M20 220h480M100 20v220M200 20v220M300 20v220M400 20v220"/></g><path d="M20 215C90 215 100 160 170 164S265 110 320 119 425 63 500 55" stroke="#d3ba75" stroke-width="4" fill="none"/><path d="M20 215C85 208 108 140 170 140S268 66 320 73 430 25 500 20" stroke="#b7d9b7" stroke-width="3" fill="none"/><path d="M20 215C95 216 115 182 170 185S265 165 320 179 435 155 500 164" stroke="#9fb9ab" stroke-width="2" stroke-dasharray="7 7" fill="none"/></svg><div class="scenario-labels"><span>{service.labels[1]}</span><span>{service.labels[2]}</span></div></div>
  : service.visual==='protection' ? <div class="evidence-art"><div class="evidence-paper"><Emblem name={service.emblem}/><strong>{service.labels[0]}</strong><div class="paper-rules" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div class="evidence-seal" aria-hidden="true"><Emblem name="secure"/></div></div><div class="evidence-check"><Emblem name="document"/><strong>{service.labels[1]}</strong></div><div class="evidence-check last"><Emblem name="review"/><strong>{service.labels[2]}</strong></div></div>
  : <ol class="flow-art" role="list">{service.labels.map((label,i)=><li class="flow-node"><Emblem name={i===0?'document':i===1?service.emblem:'clarity'}/><div><strong>{label}</strong><span>{service.flowNotes?.[i]}</span></div>{i<2&&<svg class="flow-connector" viewBox="0 0 16 24" aria-hidden="true"><path d="M8 1v20m-4-4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}</li>)}</ol>}
  <figcaption>{service.question}</figcaption>
</figure>
