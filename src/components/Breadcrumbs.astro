---
interface Props { items: {label:string;href?:string}[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Хлебные крошки"><ol><li><a href="/">Главная</a></li>{items.map(item=><li>{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
