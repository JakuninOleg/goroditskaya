---
import { minuteLabel } from '../data/editorial';
interface Props { minutes:number; date?:string; dateTime?:string; }
const {minutes,date,dateTime='2026-10-24'}=Astro.props;
---
<div class="reading-byline"><a href="/o-natale/">Наталья Городицкая</a><span>{minuteLabel(minutes)}</span>{date&&<time datetime={dateTime}>{date}</time>}</div>
