---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
interface Props { contactHref?: string; }
const { contactHref: requestedContactHref } = Astro.props;
const home = Astro.url.pathname === '/';
const contactHref = requestedContactHref ?? (home ? '#contact' : '#request');
const active = (path: string) => Astro.url.pathname === path ? 'page' : undefined;
const articlesCurrent = active('/stati/') ?? (Astro.url.pathname.startsWith('/stati/') ? 'location' : undefined);
---
<header class="masthead" id="top"><div class="masthead-shell container">
  <div class="masthead-row">
    <Brand class="identity" href={home ? '#top' : '/'}/>
    <nav class="masthead-nav" aria-label="Основная навигация">
      <a href="/o-natale/" aria-current={active('/o-natale/')}>О нас</a>
      <a href="/uslugi/" aria-current={active('/uslugi/')}>Услуги</a>
      <a href="/kejsy/" aria-current={active('/kejsy/')}>Кейсы</a>
      <a href="/stati/" aria-current={articlesCurrent}>Статьи</a>
      <a href="/#approach">Как мы работаем</a>
    </nav>
    <a class="button button-yellow masthead-cta" href={contactHref}>Получить консультацию <Icon/></a>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span><span></span></button>
  </div>
  <nav class="masthead-mobile-nav" id="mobile-nav" aria-label="Мобильная навигация" hidden>
    <a href="/#services">Направления работы</a><a href="/uslugi/">Все услуги</a>
    <a href="/uslugi/finansovyy-direktor-na-autsorse/">Финансовый директор</a><a href="/uslugi/nalogovyy-konsultant/">Налоговый консультант</a>
    <a href="/kejsy/">Кейсы</a><a href="/stati/" aria-current={articlesCurrent}>Статьи</a><a href="/o-natale/">О команде</a><a href="/materialy/">Финансовые формы</a><a href="/kontakty/">Контакты <Icon/></a>
  </nav>
</div></header>
<div class="masthead-scrim" aria-hidden="true" hidden></div>
<script>import '../scripts/navigation';</script>
