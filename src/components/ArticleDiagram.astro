---
import Icon from './Icon.astro';
import type { Article } from '../data/articles';
interface Props { type:Article['diagram']; }
const { type } = Astro.props;
const diagrams = {
  cash: { title:'Прибыль и деньги приходят в разное время', steps:[['Отгрузка','Возникает результат продажи'],['Отсрочка','Деньги остаются в расчётах'],['Оплата','Поступление в денежный поток']], note:'Платежи компании идут по своему графику. Сопоставляйте оба потока по датам.' },
  ledger: { title:'От общего остатка к его основанию', steps:[['ОСВ','Где возник вопрос'],['Аналитика счёта','Из чего состоит сумма'],['Документ и сверка','Чем подтверждён результат']], note:'Контрольное закрытие проверяет связь исправлений с итоговой отчётностью.' },
  connections: { title:'У показателя есть путь от операции до решения', steps:[['Документы','Продажи · Закупки · Склад'],['Правила расчёта','Заказы · Затраты · Закрытие'],['Отчётность','Прибыль · Деньги · Баланс']], note:'Источник данных, ответственный и контрольная сверка нужны на каждом переходе.' },
  tax: { title:'Сопоставляйте состав показателей', steps:[['Налог на прибыль','Доходы · Расходы · Период'],['Сверка операций','Документы · Регистры · Причины'],['НДС','Операции · Налоговая база · Период']], note:'Итог сверки — расшифровка причин различия, а не механическое равенство двух сумм.' },
  accounting: { title:'Один документ — данные для двух задач', steps:[['Операция','Документ · Сумма · Дата'],['Правила учёта','Счета · Статьи · Проекты'],['Отчёт собственнику','Прибыль · Деньги · Решения']], note:'Различия между отчётами объясняют правилами и сверкой, а не ручной подгонкой итогов.' },
  export: { title:'Нулевая ставка требует подтверждения', steps:[['Отгрузка','Маршрут · Товар · Контракт'],['Подтверждение','Реестр или документы по ЕАЭС'],['Декларация','Ставка 0% · Вычеты']], note:'Срок 180 дней отсчитывают от даты, установленной для вашего маршрута поставки.' },
  import: { title:'Платёж и вычет — отдельные этапы', steps:[['Поставка','ЕАЭС или третья страна'],['Ввозной НДС','Расчёт · Уплата · Документы'],['Учёт','Стоимость товара или вычет']], note:'Право на вычет зависит от режима НДС и назначения товаров. Факт уплаты сам по себе его не создаёт.' }
};
const diagram = diagrams[type];
---
<figure class="article-diagram"><figcaption>{diagram.title}</figcaption><ol>{diagram.steps.map((step,index)=><li><span class="diagram-step"><strong>{step[0]}</strong><span>{step[1]}</span></span>{index<2&&<Icon/>}</li>)}</ol><p>{diagram.note}</p></figure>
