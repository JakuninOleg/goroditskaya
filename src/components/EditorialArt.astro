    {kind==='ledger'&&<>
      <path class="art-sheet-back" d="M86 64H326V316H86z"/>
      <rect class="art-paper" x="66" y="84" width="248" height="254" rx="10"/>
      <text x="94" y="125">ОСВ</text><path class="art-hairline" d="M94 144H286M94 189H286M94 233H286M94 277H286M150 160V307M238 160V307"/>
      <rect class="art-highlight" x="83" y="197" width="212" height="29" rx="3"/>
      <path class="art-route" d="M296 211H354Q378 211 378 187V170Q378 150 400 150H424"/>
      <rect class="art-solid" x="424" y="101" width="145" height="178" rx="9"/>
      <path class="art-light-line" d="M448 133H543M448 156H516M448 205H543M448 229H528"/>
      <circle class="art-seal" cx="550" cy="271" r="29"/><path d="m536 271 10 10 18-21"/>
      <text class="art-label" x="489" y="335" text-anchor="middle">Документ</text>
    </>}
    {kind==='connections'&&<>
      <path class="art-route" d="M200 200H279M421 200H470M440 200V128Q440 105 463 105H470M440 200V274Q440 296 462 296H470"/>
      <rect class="art-paper" x="40" y="152" width="160" height="97" rx="9"/><text x="120" y="211" text-anchor="middle">Операции</text>
      <rect class="art-solid" x="279" y="152" width="142" height="97" rx="9"/><text class="art-light" x="350" y="211" text-anchor="middle">Правила</text>
      <rect class="art-paper" x="470" y="63" width="116" height="83" rx="9"/><text class="art-small" x="528" y="112" text-anchor="middle">Прибыль</text>
      <rect class="art-highlight" x="470" y="159" width="116" height="83" rx="9"/><text class="art-small" x="528" y="209" text-anchor="middle">Деньги</text>
      <rect class="art-paper" x="470" y="255" width="116" height="83" rx="9"/><text class="art-small" x="528" y="305" text-anchor="middle">Баланс</text>
