      <text class="art-label" x="320" y="367" text-anchor="middle">Сверка по операциям</text>
    </>}
    {kind==='model'&&<>
      <rect class="art-paper" x="40" y="61" width="155" height="67" rx="9"/><text x="117" y="102" text-anchor="middle">Доходы</text>
      <rect class="art-paper" x="242" y="61" width="155" height="67" rx="9"/><text x="319" y="102" text-anchor="middle">Затраты</text>
      <rect class="art-paper" x="444" y="61" width="155" height="67" rx="9"/><text class="art-small" x="521" y="102" text-anchor="middle">Финансирование</text>
      <path class="art-route" d="M117 128v28q0 22 22 22h360q22 0 22-22v-28M319 128v79"/>
      <rect class="art-solid" x="104" y="207" width="432" height="126" rx="10"/><text class="art-light" x="320" y="246" text-anchor="middle">Бюджет на три года</text>
      <path class="art-light-line" d="M130 268H510M256 283v28M385 283v28"/><text class="art-light" x="189" y="304" text-anchor="middle">1 год</text><text class="art-light" x="320" y="304" text-anchor="middle">2 год</text><text class="art-light" x="448" y="304" text-anchor="middle">3 год</text>
    </>}
    {kind==='review'&&<>
      <rect class="art-sheet-back" x="112" y="49" width="295" height="274" rx="8"/>
      <rect class="art-paper" x="88" y="73" width="295" height="274" rx="8"/>
      <text x="118" y="119">Финансовая картина</text>
      <path class="art-hairline" d="M118 140H353M156 178H353M156 226H353M156 274H295"/>
      <path class="art-mark" d="m118 176 8 8 13-15m-21 55 8 8 13-15m-21 55 8 8 13-15"/>
      <circle class="art-paper" cx="439" cy="208" r="73"/><circle class="art-route" cx="439" cy="208" r="54"/>
      <path class="art-heavy" d="m492 262 57 57"/><path class="art-gold" d="m417 208 16 16 30-34"/>
    </>}
    {kind==='planning'&&<>
      <rect class="art-paper" x="56" y="73" width="528" height="254" rx="10"/>
      <text x="84" y="113">Смета</text><text x="430" y="113">Выполнение</text>
      <path class="art-hairline" d="M82 137H558M248 154V304M348 154V304M448 154V304M82 192H558M82 245H558"/>
      <path class="art-route" d="M108 166H248M174 219H348M275 273H488"/>
      <circle class="art-seal" cx="248" cy="166" r="8"/><circle class="art-seal" cx="348" cy="219" r="8"/><circle class="art-seal" cx="488" cy="273" r="8"/>
      <text class="art-label" x="320" y="369" text-anchor="middle">От объёма работ — к затратам</text>
    </>}
    {kind==='asset'&&<>
      <rect class="art-paper" x="64" y="128" width="147" height="178" rx="9"/>
      <text x="137" y="167" text-anchor="middle">Затраты</text><path class="art-hairline" d="M88 193H187M88 222H172M88 251H187M88 280H156"/>
      <path class="art-route" d="M211 215H310Q338 215 338 187V125Q338 97 366 97H398"/>
      <rect class="art-solid" x="398" y="68" width="167" height="237" rx="9"/>
      <path class="art-light-line" d="M428 111H535M428 143H509M428 261H535"/>
