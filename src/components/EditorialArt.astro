      <text class="art-small" x="155" y="113" text-anchor="middle">Налог на прибыль</text><text x="484" y="113" text-anchor="middle">НДС</text>
      <path class="art-hairline" d="M84 141H225M84 171H201M84 268H225M84 296H174M414 141H554M414 171H527M414 268H554M414 296H502"/>
