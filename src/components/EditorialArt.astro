      <text class="art-label" x="482" y="350" text-anchor="middle">Объект учёта</text>
      <circle class="art-seal" cx="310" cy="215" r="9"/>
    </>}
    {kind==='contracts'&&<>
      <rect class="art-paper" x="67" y="64" width="214" height="270" rx="9"/>
      <text x="95" y="110">Договор</text><path class="art-hairline" d="M95 138H253M95 164H234M95 190H253M95 216H207"/>
      <path class="art-route" d="M154 276c16-24 20 19 36-7s18 4 34-9"/>
      <path class="art-route" d="M281 144H342Q362 144 362 164V263Q362 283 382 283H416"/>
      <rect class="art-solid" x="402" y="224" width="172" height="102" rx="9"/><text class="art-light" x="488" y="284" text-anchor="middle">Расчёты</text>
      <rect class="art-highlight" x="369" y="78" width="172" height="102" rx="9"/><text x="455" y="138" text-anchor="middle">Документы</text>
      <path class="art-route" d="M455 180V224"/>
    </>}
    {kind==='guarantee'&&<>
      <path class="art-route" d="M86 219H241M399 219H554"/>
      <rect class="art-paper" x="59" y="103" width="164" height="177" rx="8"/><text class="art-small" x="141" y="143" text-anchor="middle">Контракт</text>
      <path class="art-hairline" d="M85 166H197M85 191H179M85 216H197"/>
      <path class="art-solid" d="m320 65 79 33v102c0 55-46 86-79 104-33-18-79-49-79-104V98z"/>
      <path class="art-light-line" d="m283 181 25 25 48-53"/>
      <rect class="art-paper" x="417" y="103" width="164" height="177" rx="8"/><text class="art-small" x="499" y="143" text-anchor="middle">Гарантия</text>
      <path class="art-hairline" d="M443 166H555M443 191H537"/><circle class="art-seal" cx="538" cy="253" r="24"/>
      <text class="art-label" x="320" y="354" text-anchor="middle">Компания · Банк · Обеспечение</text>
    </>}
    {kind==='research'&&<>
      <circle class="art-hairline" cx="216" cy="200" r="118"/><circle class="art-hairline" cx="216" cy="200" r="78"/>
      <path class="art-route" d="M112 244 159 128 258 107 302 204 218 289Z"/>
      <circle class="art-seal" cx="159" cy="128" r="10"/><circle class="art-solid" cx="258" cy="107" r="10"/><circle class="art-solid" cx="302" cy="204" r="10"/><circle class="art-seal" cx="218" cy="289" r="10"/>
      <path class="art-route" d="M302 204H386"/>
      <rect class="art-paper" x="386" y="83" width="190" height="242" rx="9"/>
      <text x="481" y="129" text-anchor="middle">Патенты</text><path class="art-hairline" d="M414 154H548M414 181H523M414 208H548"/>
      <circle class="art-solid" cx="481" cy="267" r="29"/><path class="art-light-line" d="m468 267 9 9 18-20"/>
      <text class="art-label" x="216" y="362" text-anchor="middle">Технология</text>
    </>}
    </g>
  </svg>
  {caption&&<figcaption>{caption}</figcaption>}
</figure>
