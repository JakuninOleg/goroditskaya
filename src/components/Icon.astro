---
import ArtIcon from './ArtIcon.astro';
interface Props { name?: string; class?: string; }
const { name = 'arrow', class: className = '' } = Astro.props;
const ui: Record<string,string> = {
  arrow:'<path d="M4 12h15m-6-6 6 6-6 6"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  close:'<path d="m6 6 12 12M6 18 18 6"/>',
  check:'<path d="m5 12 4 4L19 6"/>',
  mail:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>',
  phone:'<path d="m7 3 3 5-3 3c2 3 3 4 6 6l3-3 5 3-2 4C9 22 2 15 3 5z"/>'
};
---
{ui[name] ? <svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g set:html={ui[name]}/></svg> : <ArtIcon name={name} class={className}/>}
