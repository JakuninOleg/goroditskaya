---
interface Props { name?: 'arrow' | 'plus' | 'check' | 'close'; class?: string; }
const { name = 'arrow', class: className = '' } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" />}
  {name === 'check' && <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" stroke="currentColor" stroke-width="1.5" />}
</svg>
