---
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';
import { specialTasks } from '../data/site';
import { taskSlugs, serviceHref } from '../data/services';
const contours = [
 {id:'accounting',title:'Учёт и 1С',subtitle:'Автоматизация 1С · Восстановление учёта',icon:'system',tasks:['automation','accounting']},
 {id:'capital',title:'Капитал и активы',subtitle:'Финансирование · НИОКР и НМА',icon:'clarity',tasks:['funding','assets']},
 {id:'requirements',title:'Особые требования',subtitle:'Раздельный учёт ГОЗ · Due diligence',icon:'review',tasks:['goz','diligence']}
];
const inputs=[{name:'Продажи',icon:'clarity'},{name:'Закупки',icon:'inventory'},{name:'Склад',icon:'inventory'},{name:'Зарплата',icon:'team'},{name:'Основные средства',icon:'system'}];
const reports=[{name:'ДДС',text:'Денежный поток',values:[28,35,25,54,43,68,88],icon:'clarity'},{name:'Прибыль',text:'Результат направлений',values:[38,25,48,35,58,75,66],icon:'profit'},{name:'Баланс',text:'Активы и обязательства',values:[20,32,28,45,63,60,84],icon:'document'}];
---
<section class="section workbench-section" id="expert-tasks" aria-labelledby="special-heading"><div class="container">
 <div class="workbench-heading"><h2 id="special-heading">Для сложных задач</h2><p>Выберите контур, который нужно настроить.</p></div>
 <div class="expert-workbench" data-tabs>
  <div class="workbench-tabs" role="tablist" aria-label="Контуры финансовой системы">{contours.map((item,i)=><button type="button" role="tab" id={'contour-tab-'+item.id} aria-controls={'contour-panel-'+item.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-tab={item.id}><Emblem name={item.icon}/><span><strong>{item.title}</strong><small>{item.subtitle}</small></span></button>)}</div>
  <div class="workbench-surface" data-tab-surface>
   <div role="tabpanel" id="contour-panel-accounting" aria-labelledby="contour-tab-accounting" data-panel="accounting">
    <div class="accounting-map">
     <svg class="hub-connections" aria-hidden="true"></svg>
     <div class="workbench-inputs"><h3>Данные бизнеса</h3><ul>{inputs.map(item=><li><Emblem name={item.icon}/><span>{item.name}</span><i aria-hidden="true"></i></li>)}</ul></div>
     <div class="accounting-hub">
      <div class="system-stack" aria-hidden="true">{inputs.map((_,i)=><span class="hub-port hub-input-port" style={'--port:'+i}></span>)}{reports.map((_,i)=><span class="hub-port hub-output-port" style={'--port:'+i}></span>)}<span class="system-layer layer-back"></span><span class="system-layer layer-middle"></span><div class="system-module"><span class="module-label">1С</span><span class="module-lights"><i></i><i></i></span><span class="module-line"></span><span class="module-line"></span><span class="module-line"></span><span class="module-line"></span></div><span class="module-base"></span></div>
      <div class="hub-caption"><strong>Единая система учёта</strong><span>ERP · КА · КОРП · Бит.Финанс</span></div>
     </div>
     <div class="workbench-reports">{reports.map(report=><div class="workbench-report"><div class="workbench-report-heading"><Emblem name={report.icon}/><div><h3>{report.name}</h3><p>{report.text}</p></div></div><div class="workbench-mini-chart" aria-hidden="true">{report.values.map((value,i)=><span style={'--height:'+value+'%'} class={i===report.values.length-1?'highlight':''}></span>)}</div></div>)}</div>
    </div>
    <div class="workbench-summary"><div><Icon name="check"/><p><strong>Данные связаны.</strong><span>Отчётность отвечает на вопросы собственника.</span></p></div><a class="button button-green" href="#contact" data-task="Учёт и 1С">Обсудить задачу <Icon/></a></div>
   </div>
   <div role="tabpanel" id="contour-panel-capital" aria-labelledby="contour-tab-capital" data-panel="capital" hidden>
    <div class="expert-path"><div class="expert-path-art"><Emblem name="clarity"/><span class="path-rule"></span><Emblem name="profit"/><span class="path-rule"></span><Emblem name="tax"/></div><div><h3>Финансовая модель для роста</h3><p>Обосновать финансирование. Разобраться в стоимости разработок. Подготовить данные для банка и инвестора.</p></div></div>
    <div class="expert-pair"><article><Emblem name="payments"/><h3>Финансирование</h3><p>Кредитный пакет, долговая нагрузка и сценарии погашения. Кредиты, гарантии и лизинг.</p><span>Результат: финансовая модель и пакет документов для рассмотрения.</span></article><article><Emblem name="review"/><h3>НИОКР и НМА</h3><p>Затраты, права и документы по разработкам. Проверка оснований для признания технологии активом.</p><span>Результат: методология учёта и обоснование капитализации.</span></article></div>
    <div class="workbench-summary"><div><Icon name="check"/><p><strong>Понятна потребность в деньгах.</strong><span>Решения опираются на модель и документы.</span></p></div><a class="button button-green" href="#contact" data-task="Финансирование, НИОКР и НМА">Обсудить задачу <Icon/></a></div>
   </div>
   <div role="tabpanel" id="contour-panel-requirements" aria-labelledby="contour-tab-requirements" data-panel="requirements" hidden>
    <div class="expert-path"><div class="expert-path-art"><Emblem name="document"/><span class="path-rule"></span><Emblem name="review"/><span class="path-rule"></span><Emblem name="secure"/></div><div><h3>Учёт, который выдерживает проверку</h3><p>Связать первичные документы, аналитику по контрактам и отчётность. Подготовить материалы к внешней проверке.</p></div></div>
    <div class="expert-pair"><article><Emblem name="secure"/><h3>Раздельный учёт ГОЗ</h3><p>Методология и аналитика по контрактам государственного оборонного заказа. Настройка учётного контура под требования 275-ФЗ.</p><span>Результат: согласованные правила и раздельный учёт по контрактам.</span></article><article><Emblem name="review"/><h3>Подготовка к due diligence</h3><p>Финансовые, бухгалтерские и налоговые данные для инвестора. Проверка согласованности отчётности и полноты материалов.</p><span>Результат: отчёты и документы по списку запросов инвестора.</span></article></div>
    <div class="workbench-summary"><div><Icon name="check"/><p><strong>Показатели подтверждены документами.</strong><span>Понятно, что подтверждает каждый показатель.</span></p></div><a class="button button-green" href="#contact" data-task="Раздельный учёт ГОЗ и подготовка к due diligence">Обсудить задачу <Icon/></a></div>
   </div>
  </div>
  <div class="workbench-details" data-tab-surface>{contours.map((contour,i)=><div data-panel={contour.id} hidden={i!==0}><span>Состав работ:</span>{contour.tasks.map(id=>{const task=specialTasks.find(task=>task.id===id)!;return <a class="inline-link" href={serviceHref(taskSlugs[id])}>{task.title}</a>})}</div>)}</div>
 </div>
 <noscript><div class="workbench-noscript">{specialTasks.map(task=><article><h3>{task.title}</h3><p>{task.detail}</p></article>)}</div></noscript>
</div></section>
<script>
 const ns='http://www.w3.org/2000/svg';
 document.querySelectorAll<HTMLElement>('.accounting-map').forEach(map=>{
  const svg=map.querySelector<SVGSVGElement>('.hub-connections')!;
  const inputs=[...map.querySelectorAll<HTMLElement>('.workbench-inputs li i')];
  const incoming=[...map.querySelectorAll<HTMLElement>('.hub-input-port')];
  const outgoing=[...map.querySelectorAll<HTMLElement>('.hub-output-port')];
  const reports=[...map.querySelectorAll<HTMLElement>('.workbench-report')];
  const hub=map.querySelector<HTMLElement>('.accounting-hub')!;
  const reportGroup=map.querySelector<HTMLElement>('.workbench-reports')!;
  function draw(){
   const box=svg.getBoundingClientRect();
   if(!box.width||getComputedStyle(svg).display==='none')return;
   const center=(element:Element)=>{const r=element.getBoundingClientRect();return {x:r.left+r.width/2-box.left,y:r.top+r.height/2-box.top};};
   const fragment=document.createDocumentFragment();
   const dot=(point:{x:number;y:number},color:string)=>{
    const circle=document.createElementNS(ns,'circle');
    for(const [name,value] of Object.entries({cx:point.x,cy:point.y,r:3,fill:color,stroke:'#fffdf1','stroke-width':2}))circle.setAttribute(name,String(value));
    fragment.append(circle);
   };
   const connect=(start:{x:number;y:number},end:{x:number;y:number})=>{
    const path=document.createElementNS(ns,'path');
    const bend=(end.x-start.x)/2;
    path.setAttribute('d',`M ${start.x} ${start.y} C ${start.x+bend} ${start.y}, ${end.x-bend} ${end.y}, ${end.x} ${end.y}`);
    path.setAttribute('fill','none');path.setAttribute('stroke','#69958a');path.setAttribute('stroke-width','1.5');
    fragment.append(path);
   };
   inputs.forEach((input,i)=>{const end=center(incoming[i]);connect(center(input),end);dot(end,'#edc94e');});
   if(reportGroup.getBoundingClientRect().left>=hub.getBoundingClientRect().right-1){
    reports.forEach((report,i)=>{
     const start=center(outgoing[i]);const end=center(report);end.x=report.getBoundingClientRect().left-box.left;
     connect(start,end);dot(start,'#edc94e');dot(end,'#235b4b');
    });
   }
   svg.replaceChildren(fragment);
  }
  // Use rendered positions so resized layouts and fonts keep every endpoint aligned.
  const observer=new ResizeObserver(draw);
  [map,map.querySelector('.workbench-inputs ul')!,reportGroup].forEach(element=>observer.observe(element));
  document.fonts.ready.then(draw);
 });
</script>
