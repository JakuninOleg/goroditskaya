---
import Icon from './Icon.astro';
import Emblem from './Emblem.astro';
import { questions, questionCheckIcons } from '../data/site';
import '../styles/iceberg.css';
const featured=[0,1,2,4];
const checkArt=(position:number)=>[...new Set(questionCheckIcons.map(row=>row[position]))];
---
<section class="needs-section" id="tasks" aria-labelledby="tasks-heading">
 <div class="needs-background" aria-hidden="true"><picture><source type="image/avif" srcset="/images/hybrid/iceberg-panorama-960.avif 960w, /images/hybrid/iceberg-panorama-1280.avif 1280w, /images/hybrid/iceberg-panorama.avif 1916w" sizes="100vw"/><img src="/images/hybrid/iceberg-panorama.webp" width="1916" height="821" alt="" loading="lazy" decoding="async"/></picture></div>
 <svg class="needs-leaders" aria-hidden="true" fill="none" hidden><path data-surface-leader/><path data-depth-leader/><circle class="needs-leader-ring" data-surface-ring r="8"/><circle class="needs-leader-ring" data-depth-ring r="8"/><circle class="needs-leader-dot" data-surface-dot r="3.5"/><circle class="needs-leader-dot" data-depth-dot r="3.5"/><path class="needs-leader-arrow" data-depth-arrow/></svg>
 <div class="needs-container container">
  <div class="needs-intro"><p class="needs-eyebrow">Вопросы собственника</p><h2 id="tasks-heading"><span class="needs-title-first">Ваш вопрос —</span> <span class="needs-title-rest">вершина айсберга</span></h2></div>
  <div class="needs-layout">
   <div class="needs-choices"><p class="needs-choice-label sr-only" id="needs-question-label">Выберите свой вопрос</p>
    <div class="needs-desktop-choices"><div class="needs-question-list" role="group" aria-labelledby="needs-question-label">{featured.map(index=><button class="needs-question" type="button" data-question={index} aria-pressed={index===0?'true':'false'} aria-controls="iceberg-answer"><span>{questions[index].title}</span><Icon/></button>)}</div><details class="needs-more"><summary aria-controls="needs-more-panel">Другие вопросы <Icon name="plus"/></summary><div id="needs-more-panel">{questions.map((q,index)=>!featured.includes(index)&&<button type="button" data-question={index} aria-pressed="false" aria-controls="iceberg-answer">{q.title}</button>)}</div></details></div>
    <div class="needs-mobile-choice"><div class="needs-selected-question" aria-hidden="true"><span data-selected-question>{questions[0].title}</span><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m5 9 7 7 7-7"/></svg></div><select id="needs-question" data-question-select aria-labelledby="needs-question-label" aria-controls="iceberg-answer">{questions.map((q,index)=><option value={index} selected={index===0}>{q.title}</option>)}</select></div>
   </div>
   <div class="needs-response" id="iceberg-answer" aria-live="polite" aria-atomic="true">
    <div class="needs-visual"><picture class="needs-scene"><source type="image/avif" srcset="/images/hybrid/iceberg-panorama-960.avif 960w, /images/hybrid/iceberg-panorama-1280.avif 1280w, /images/hybrid/iceberg-panorama.avif 1916w" sizes="(max-width:640px) 130vw, 100vw"/><img src="/images/hybrid/iceberg-panorama.webp" width="1916" height="821" alt="Вершина айсберга над водой и значительно большая подводная часть" loading="lazy" decoding="async"/></picture><div class="needs-surface"><p>На поверхности</p><h3 data-iceberg-headline>{questions[0].headline}</h3></div></div>
    <div class="needs-depth"><h3>Что проверим глубже</h3><ul class="needs-check-list">{questions[0].checks.map((check,index)=><li><span class="needs-check-art">{checkArt(index).map(name=><span data-check-art={name} data-check-position={index} hidden={name!==questionCheckIcons[0][index]}><Emblem name={name}/></span>)}</span><span data-iceberg-check={index}>{check}</span></li>)}</ul><p class="sr-only" data-iceberg-explanation>{questions[0].explanation}</p></div>
   </div>
  </div>
  <div class="needs-footer"><p>Свяжем прибыль, платежи и остатки денег.</p><a class="button button-yellow" href="#contact" data-iceberg-contact data-task={questions[0].title}>Разобрать мою ситуацию <Icon/></a></div>
 </div>
</section>

<script>import '../scripts/iceberg-leaders';</script>
