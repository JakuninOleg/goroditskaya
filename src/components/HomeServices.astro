---
import Icon from './Icon.astro';
import { services, serviceHref } from '../data/services';

const descriptions: Record<string, string> = {
 'finansovyy-direktor-na-autsorse': 'Бюджет, денежный поток и регулярная работа с решениями собственника.',
 'finansovaya-diagnostika': 'Проверка цифр, причин потерь и финансовых рисков.',
 'finansovaya-model': 'Сценарии роста, прогноз прибыли и потребности в деньгах.',
 'gotovnost-k-finansirovaniyu': 'Финансовая модель и материалы для банка или инвестора.',
 'podgotovka-k-due-diligence': 'Отчётность и подтверждающие документы к проверке бизнеса.',
 'upravlencheskiy-uchet-proizvodstva': 'Себестоимость и прибыль по заказам для производства и проектов.',
 'avtomatizatsiya-ucheta-1c': 'Методология, настройка 1С ERP и связанные отчёты.',
 'vosstanovlenie-ucheta': 'Документы, сверки и исправление учётной базы.',
 'uchet-goz': 'Затраты и финансовый результат по каждому контракту.',
 'niokr-nma': 'От затрат на разработки до признания созданных активов.',
 'nalogovyy-konsultant': 'НДС, налог на прибыль, требования и позиция компании.',
 'nalogovaya-proverka': 'Документы, возражения и сопровождение налоговых споров.',
 'yurist-dlya-biznesa': 'Договоры, корпоративные вопросы и защита интересов компании.'
};
const titles: Record<string, string> = {
 'finansovaya-diagnostika': 'Финансовая диагностика',
 'gotovnost-k-finansirovaniyu': 'Подготовка к финансированию',
 'podgotovka-k-due-diligence': 'Подготовка к due diligence',
 'upravlencheskiy-uchet-proizvodstva': 'Управленческий учёт',
 'avtomatizatsiya-ucheta-1c': 'Автоматизация учёта в 1С',
 'vosstanovlenie-ucheta': 'Восстановление бухгалтерского учёта',
 'niokr-nma': 'Учёт НИОКР и НМА'
};
const groups = [
 { key:'finance', title:'Финансовое управление', category:'Финансовое управление', intro:'Понимать цифры. Планировать рост.', caption:'Прибыль · Деньги · Баланс' },
 { key:'accounting', title:'Учёт и системы', category:'Учёт и системы', intro:'Связать операции и отчётность.', caption:'Документы → 1С → Отчётность' },
 { key:'protection', title:'Налоги и право', category:'Налоги и право', intro:'Подготовить документы. Защитить позицию.', caption:'Факты · Документы · Защита' }
];
---
<section class="section container service-atlas" id="services" aria-labelledby="products-heading">
 <div class="atlas-heading">
  <h2 id="products-heading">Финансы, учёт<br/>и защита бизнеса</h2>
  <div><p>Для производственных, строительных и ИТ-компаний. От разбора одной задачи до ведения финансовой системы.</p><a class="text-link" href="/uslugi/">Все услуги <Icon/></a></div>
 </div>
 <div class="atlas-groups">
  {groups.map(group => <article class={'atlas-group atlas-'+group.key} aria-labelledby={'atlas-'+group.key+'-heading'}>
   <header class="atlas-group-heading">
    <div><h3 id={'atlas-'+group.key+'-heading'}>{group.title}</h3><p>{group.intro}</p></div>
    <figure class="atlas-art" aria-label={group.caption}>
     {group.key==='finance' ? <svg viewBox="0 0 232 132" fill="none" aria-hidden="true">
      <path d="M12 112H220M12 80H220M12 48H220M12 16H220" stroke="currentColor" opacity=".12"/>
      <path d="M21 92C48 92 47 66 75 66S100 77 126 51 166 54 211 16" stroke="#e6c674" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M23 112V97H39V112M62 112V83H78V112M101 112V78H117V112M140 112V65H156V112M179 112V42H195V112" fill="#b2cfbb" opacity=".8"/>
      <circle cx="211" cy="16" r="5" fill="#e6c674"/><circle cx="126" cy="51" r="4" fill="#f8f5e8"/>
     </svg> : group.key==='accounting' ? <svg viewBox="0 0 232 132" fill="none" aria-hidden="true">
      <path d="M39 41H86C108 41 103 66 123 66H194M39 91H86C108 91 103 66 123 66" stroke="#5c8872" stroke-width="1.5"/>
      <rect x="13" y="21" width="47" height="40" rx="5" fill="#f9f8ef" stroke="#a2b69e"/><path d="M24 33H49M24 41H44M24 49H39" stroke="#507560" stroke-width="2"/>
      <rect x="13" y="71" width="47" height="40" rx="5" fill="#f9f8ef" stroke="#a2b69e"/><path d="M24 84H49M24 92H44M24 100H39" stroke="#507560" stroke-width="2"/>
      <rect x="96" y="41" width="52" height="50" rx="12" fill="#1b4a3c"/><text x="122" y="73" fill="#f5e6af" text-anchor="middle" font-family="Manrope, sans-serif" font-size="22" font-weight="600">1С</text>
      <rect x="180" y="36" width="39" height="59" rx="5" fill="#f9f8ef" stroke="#a2b69e"/><path d="M189 83V69H194V83M199 83V58H204V83M209 83V48H214V83" fill="#527e67"/><circle cx="166" cy="66" r="3" fill="#a37b32"/>
     </svg> : <svg viewBox="0 0 232 132" fill="none" aria-hidden="true">
      <rect x="36" y="14" width="97" height="104" rx="6" fill="#e2e9d9"/><rect x="48" y="8" width="97" height="104" rx="6" fill="#faf8ee" stroke="#b3bfa6"/>
      <path d="M64 27H125M64 39H112M64 63H111M64 75H99M64 87H106" stroke="#8a9d80" stroke-width="2" stroke-linecap="round"/>
      <path d="M154 37L185 48V74C185 98 154 114 154 114S123 98 123 74V48L154 37Z" fill="#1b4a3c" stroke="#d6bd79" stroke-width="1.5"/>
      <path d="M142 75L151 84L168 62" stroke="#e9d48e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
     </svg>}
     <figcaption>{group.caption}</figcaption>
    </figure>
   </header>
   <ul class="atlas-links">
    {services.filter(service => service.category===group.category).map(service => <li>
     <a href={serviceHref(service.slug)}>
      <div><h4>{titles[service.slug] ?? service.title}</h4><p>{descriptions[service.slug]}</p></div><span class="service-arrow" aria-hidden="true"><Icon/><Icon class="service-arrow-next"/></span>
     </a>
    </li>)}
   </ul>
  </article>)}
 </div>
 <div class="atlas-footer"><p>Задача затрагивает несколько направлений?<br/>Подключаю профильных специалистов под ваш проект.</p><a class="text-link" href="#contact">Обсудить задачу <Icon/></a></div>
</section>

<style>
 .atlas-heading{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:end;margin-bottom:40px}
 .atlas-heading>div{max-width:460px;justify-self:end}
 .atlas-heading p{font-size:19px;line-height:1.6;color:#405b50}
 .atlas-heading .text-link{margin-top:12px}
 .atlas-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
 .atlas-group{min-width:0;padding:32px;border-radius:16px;background:#e6ecdf;color:var(--green)}
 .atlas-finance{background:#153e39;color:#f6f3e7}
 .atlas-group-heading{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:20px;align-items:center;margin-bottom:28px}
 .atlas-group h3{font-size:30px;font-weight:600;line-height:1.2;letter-spacing:-.035em;color:inherit;text-wrap:initial}
 .atlas-group-heading>div>p{margin-top:12px;font-size:17px;line-height:1.5}
 .atlas-finance .atlas-group-heading>div>p{color:#d2dfd0}
 .atlas-art{width:100%;min-width:0}
 .atlas-art svg{display:block;width:100%;height:auto}
 .atlas-art figcaption{margin-top:8px;text-align:center;font-size:11px;line-height:1.5;font-weight:500;color:#4c6557}
 .atlas-finance .atlas-art figcaption{color:#d2dfd0}
 .atlas-links{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px}
 .atlas-links>li{min-width:0;border-top:1px solid #9aaf9570}
 .atlas-links>li:first-child{grid-column:1/-1}
 .atlas-links a{display:flex;justify-content:space-between;align-items:start;gap:16px;height:100%;min-height:128px;padding:22px 0;transition:color 180ms ease}
 .atlas-links h4{font-family:var(--sans);font-size:20px;font-weight:600;line-height:1.4;letter-spacing:-.02em;color:inherit;text-wrap:initial}
 .atlas-links>li:first-child h4{font-size:24px;line-height:1.35;max-width:560px}
 .atlas-links p{font-size:16px;line-height:1.55;margin-top:8px;color:#405b50;max-width:52ch}
 .atlas-finance .atlas-links p{color:#d2dfd0}
 .service-arrow{position:relative;display:grid;place-items:center;flex-shrink:0;overflow:hidden;width:36px;height:36px;border:1px solid color-mix(in srgb,currentColor 35%,transparent);border-radius:50%;background:transparent;transition:background-color 240ms ease,border-color 240ms ease,color 240ms ease,transform 180ms var(--ease)}
 .service-arrow :global(svg){grid-area:1/1;width:21px;height:21px;transition:transform 320ms var(--ease),opacity 200ms ease}
 .service-arrow :global(.service-arrow-next){opacity:0;transform:translateX(-32px)}
 .atlas-links a:is(:hover,:focus-visible) .service-arrow{background:#edc94e;border-color:#edc94e;color:#153e39}
 .atlas-links a:is(:hover,:focus-visible) .service-arrow :global(svg:first-child){opacity:0;transform:translateX(32px)}
 .atlas-links a:is(:hover,:focus-visible) .service-arrow :global(.service-arrow-next){opacity:1;transform:translateX(0);transition-delay:40ms}
 .atlas-links a:active .service-arrow{transform:scale(.94)}
 .atlas-finance a:focus-visible{outline-color:#edc94e}
 .atlas-protection{grid-column:1/-1;display:grid;grid-template-columns:250px minmax(0,1fr);gap:36px;padding:32px;background:#ede9dc}
 .atlas-protection .atlas-group-heading{grid-template-columns:1fr;margin:0;gap:16px;align-content:start}
 .atlas-protection .atlas-art{width:150px;justify-self:start}
 .atlas-protection .atlas-links{grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
 .atlas-protection .atlas-links>li:first-child{grid-column:auto}
 .atlas-protection .atlas-links a{padding-block:24px 0}
 .atlas-protection .atlas-links h4,.atlas-protection .atlas-links>li:first-child h4{font-size:21px;line-height:1.4}
 .atlas-footer{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-top:28px}
 .atlas-footer p{font-size:16px;line-height:1.6;color:#405b50}
 @media(min-width:1181px){
  .atlas-groups{grid-template-rows:repeat(4,auto) auto}
  .atlas-group:not(.atlas-protection){display:grid;grid-row:span 4;grid-template-rows:subgrid;row-gap:0}
  .atlas-group:not(.atlas-protection) .atlas-links{grid-row:span 3;grid-template-rows:subgrid;row-gap:0}
 }
 @media(min-width:1600px){.atlas-group{padding:36px}.atlas-group-heading{grid-template-columns:minmax(0,1fr) 200px}.atlas-group h3{font-size:34px}.atlas-protection{grid-template-columns:280px minmax(0,1fr)}}
 @media(max-width:1180px){
  .atlas-heading{gap:32px}.atlas-heading p{font-size:18px}
  .atlas-group{padding:26px}.atlas-group-heading{grid-template-columns:1fr;gap:20px;margin-bottom:20px;align-items:start}
  .atlas-art{width:190px}.atlas-group h3{font-size:28px}.atlas-links{grid-template-columns:1fr}.atlas-links>li:first-child{grid-column:auto}
  .atlas-links a{min-height:0;padding-block:20px}.atlas-links h4,.atlas-links>li:first-child h4{font-size:21px;line-height:1.4}
  .atlas-protection{grid-template-columns:1fr;gap:24px}.atlas-protection .atlas-group-heading{grid-template-columns:1fr 180px;align-items:center;gap:28px}
  .atlas-protection .atlas-art{width:180px}.atlas-protection .atlas-links{gap:24px}
 }
 @media(max-width:700px){
  .atlas-heading{grid-template-columns:1fr;gap:20px;margin-bottom:28px}.atlas-heading>div{justify-self:start;max-width:none}.atlas-heading p{font-size:18px}
  .atlas-groups{grid-template-columns:1fr;gap:20px}.atlas-group{padding:24px}.atlas-group-heading{grid-template-columns:minmax(0,1fr) 110px;gap:16px;align-items:center;margin-bottom:20px}
  .atlas-group h3{font-size:26px}.atlas-group-heading>div>p{font-size:16px;margin-top:10px}.atlas-art{width:110px}.atlas-art figcaption{display:none}
  .atlas-links a{padding-block:20px;gap:16px}.atlas-links h4,.atlas-links>li:first-child h4{font-size:20px;line-height:1.4}.atlas-links p{font-size:16px}
  .atlas-protection{grid-column:auto;display:block}.atlas-protection .atlas-group-heading{grid-template-columns:minmax(0,1fr) 110px;gap:16px;margin-bottom:20px}.atlas-protection .atlas-art{width:110px}
  .atlas-protection .atlas-links{grid-template-columns:1fr;gap:0}.atlas-protection .atlas-links a{padding-block:20px}.atlas-protection .atlas-links h4{font-size:20px}
  .atlas-footer{align-items:start;flex-direction:column;gap:12px;margin-top:24px}
 }
 @media(max-width:380px){.atlas-group{padding:20px}.atlas-group-heading,.atlas-protection .atlas-group-heading{grid-template-columns:minmax(0,1fr) 85px;gap:12px}.atlas-art,.atlas-protection .atlas-art{width:85px}.atlas-group h3{font-size:24px}}
 @media(max-width:350px){.atlas-group-heading,.atlas-protection .atlas-group-heading{grid-template-columns:1fr}.atlas-art,.atlas-protection .atlas-art{width:130px}}
 @media(prefers-reduced-motion:reduce){
  .service-arrow{transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease}
  .service-arrow :global(svg){transition:none}
  .atlas-links a:is(:hover,:focus-visible) .service-arrow :global(svg:first-child){opacity:1;transform:none}
  .atlas-links a:is(:hover,:focus-visible) .service-arrow :global(.service-arrow-next){opacity:0;transform:translateX(-32px)}
  .atlas-links a:active .service-arrow{transform:none}
 }
</style>
