---
import type { SituationArt } from '../data/business-situations';
interface Props { kind: SituationArt; }
const { kind } = Astro.props;
const base = `/images/situations/${kind}-v1`;
---
<picture class="situation-illustration" aria-hidden="true">
  <source type="image/avif" srcset={`${base}-320.avif 320w, ${base}-640.avif 640w`} sizes="(max-width:640px) 128px, 240px"/>
  <img src={`${base}-320.webp`} srcset={`${base}-320.webp 320w, ${base}-640.webp 640w`} sizes="(max-width:640px) 128px, 240px" width="640" height="640" alt="" loading="lazy" decoding="async"/>
</picture>
