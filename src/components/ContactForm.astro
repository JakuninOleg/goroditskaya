---
import Icon from './Icon.astro';
import ConsentField from './ConsentField.astro';
import FormFeedback from './FormFeedback.astro';
import { site } from '../data/site';
import '../styles/contact-form.css';
interface Props { standalone?: boolean; service?: string; }
const { standalone=false,service }=Astro.props;
const Heading=standalone?'h2':'h3';
---
<div class="contact-panel"><Heading>Заявка на консультацию</Heading>
  <form id="contact-form" method="post" aria-describedby="contact-feedback">
    <input type="hidden" name="service" value={service??''}/>
    <input type="hidden" name="page" value={Astro.url.pathname}/>
    <div class="form-grid">
      <label>Ваше имя <small class="contact-optional">необязательно</small><input name="name" autocomplete="name" placeholder="Как к вам обращаться" maxlength="100"/></label>
      <div class="contact-method">
        <div class="contact-method-heading">
          <label id="contact-method-label" for="contact-phone"><span data-contact-caption>Телефон</span> <span aria-hidden="true">*</span></label>
          <button type="button" class="contact-channel-toggle" aria-controls="contact-method-fields">Удобнее по почте?</button>
        </div>
        <div id="contact-method-fields"><input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" maxlength="18" required/>
        <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Ваша почта" maxlength="254" hidden disabled/></div>
      </div>
    </div>
    <details class="contact-details">
      <summary>Добавить подробности задачи <Icon name="plus"/></summary>
      <div class="contact-details-body"><label for="contact-message">Что хотите решить?<textarea id="contact-message" name="message" rows="3" placeholder="Например: прибыль есть, а денег на платежи не хватает" maxlength="3000"></textarea></label></div>
    </details>
    <ConsentField/>
    <button class="button button-yellow form-submit" type="submit"><span data-submit-label>Отправить заявку</span><Icon/></button>
    <FormFeedback id="contact-feedback"/>
  </form>
  <noscript><style>#contact-form{display:none}</style><p class="form-note">Можно написать напрямую: <a href={'mailto:'+site.email}>{site.email}</a>.</p></noscript>
</div>
<script>import '../scripts/contact';</script>
