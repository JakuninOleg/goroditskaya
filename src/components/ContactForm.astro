---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { standalone?: boolean; service?: string; }
const { standalone=false,service }=Astro.props;
const Heading=standalone?'h2':'h3';
---
<div class="contact-panel"><Heading>Обсудить проект</Heading>
  <form id="contact-form" action={'mailto:'+site.email} method="post" enctype="text/plain">
    {service&&<input type="hidden" name="service" value={service}/>}
    <div class="form-grid">
      <label>Ваше имя <span aria-hidden="true">*</span><input name="name" autocomplete="name" placeholder="Как к вам обращаться" required maxlength="100"/></label>
      <label>Компания {standalone&&<span aria-hidden="true">*</span>}<input name="company" autocomplete="organization" placeholder="Название компании" maxlength="180" required={standalone}/></label>
      <label>Ваша почта <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" placeholder="ivan@mail.ru" required maxlength="254"/></label>
      <label for="contact-phone">Телефон <span aria-hidden="true">*</span><input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" maxlength="18" required/></label>
      <label class="form-wide">Что хотите решить?<textarea name="message" rows="4" placeholder="Коротко о задаче, текущей системе учёта и решении, которое предстоит принять" maxlength="3000"></textarea></label>
    </div>
    <label class="consent-label"><input type="checkbox" name="consent" required/><span>Согласен с <button type="button" class="inline-link" data-privacy-open>политикой конфиденциальности</button> и обработкой персональных данных</span></label>
    <button class="button button-yellow form-submit" type="submit">Отправить заявку <Icon/></button>
  </form>
  <noscript><p class="form-note">Можно написать напрямую: <a href={'mailto:'+site.email}>{site.email}</a>.</p></noscript>
</div>
<script>import '../scripts/contact';</script>
