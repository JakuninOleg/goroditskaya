---
import ContactForm from './ContactForm.astro';
interface Props { title?:string; text?:string; service?:string; }
const { title='Начнём с вашей задачи',text='Расскажите, какое решение предстоит принять. Определим, какие данные и формат работы для этого нужны.',service }=Astro.props;
---
<section class="page-cta page-request" id="request" aria-labelledby="request-heading"><div class="container"><div class="page-request-copy"><h2 id="request-heading">{title}</h2><p>{text}</p>{service&&<p class="request-subject">{service}</p>}</div><ContactForm service={service}/></div></section>
