---
import Icon from './Icon.astro';
interface Props { title?:string; text?:string; service?:string; }
const { title='Начнём с вашей задачи',text='Расскажите, какое решение предстоит принять. Определим, какие данные и формат работы для этого нужны.',service }=Astro.props;
const href='/kontakty/'+(service?'?service='+encodeURIComponent(service):'')+'#request';
---
<section class="page-cta"><div class="container"><div><p class="eyebrow">Личное ведение проекта</p><h2>{title}</h2><p>{text}</p></div><a class="button button-yellow" href={href}>Обсудить задачу <Icon/></a></div></section>
