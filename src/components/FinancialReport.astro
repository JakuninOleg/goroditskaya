---
import Icon from './Icon.astro';
const rows = [{name:'А',plan:100,fact:92},{name:'Б',plan:80,fact:86},{name:'В',plan:60,fact:58}];
const months = ['Янв','Фев','Мар','Апр','Май','Июн','Июл','Авг','Сен','Окт','Ноя','Дек'];
const revenue = [3.2,3.5,3.4,3.8,4.1,4.6,4.2,4,4.3,4.5,4.1,4.5];
const profit = [.4,.45,.35,.55,.65,.8,.6,.7,.7,.85,.7,.85];
---
<section class="section container model-section" id="financial-model" aria-labelledby="model-heading">
  <div class="model-layout" data-tabs>
    <div class="model-copy"><p class="section-kicker">Результат</p><h2 id="model-heading">Цифры,<br/>которые объясняют</h2><p>Настраиваю понятную и наглядную отчётность под задачи бизнеса. Вы видите ключевые показатели и можете принимать решения на основе данных.</p><a class="button button-yellow" href="#model-dashboard">Посмотреть пример <Icon/></a></div>
    <div class="dashboard-shell" id="model-dashboard">
      <div class="dashboard-sidebar"><div class="dashboard-brand"><span>НГ</span>Финансы</div><div class="model-tabs" role="tablist" aria-label="Примеры финансовых инструментов"><button type="button" role="tab" id="tab-report" aria-controls="panel-report" aria-selected="true" data-tab="report"><Icon name="report"/>Обзор</button><button type="button" role="tab" id="tab-model" aria-controls="panel-model" aria-selected="false" tabindex="-1" data-tab="model"><Icon name="roadmap"/>Модель</button><button type="button" role="tab" id="tab-budget" aria-controls="panel-budget" aria-selected="false" tabindex="-1" data-tab="budget"><Icon name="ledgers"/>Бюджет</button></div><div class="dashboard-sidebar-note">Модель.<br/>План.<br/>Факт.</div></div>
      <div class="report-card">
        <div role="tabpanel" id="panel-report" aria-labelledby="tab-report" data-panel="report" tabindex="0">
          <div class="report-heading"><h3>Ключевые показатели</h3><span>Пример за год</span></div>
          <div class="dashboard-metrics"><div><span>Выручка</span><strong>48,2 млн ₽</strong></div><div><span>Прибыль</span><strong>7,6 млн ₽</strong></div><div><span>Рентабельность</span><strong>15,8%</strong></div><div><span>Остаток денег</span><strong>12,4 млн ₽</strong></div></div>
          <div class="chart-heading"><h4>Динамика выручки и прибыли</h4><div class="chart-legend"><span><i class="legend-plan"></i>Выручка</span><span><i class="legend-fact"></i>Прибыль</span></div></div>
          <div class="report-chart"><svg viewBox="0 0 720 220" role="img" aria-label="Демонстрация отчётности: за год выручка 48,2 млн рублей, прибыль 7,6 млн рублей. Условные данные.">
            {[0,2,4,6].map(value=><g><line x1="32" x2="710" y1={182-value*26} y2={182-value*26} class="chart-grid"/><text x="22" y={186-value*26} text-anchor="end" class="chart-label">{value}</text></g>)}
            {months.map((month,i)=><g><title>{month}: выручка {revenue[i].toLocaleString('ru-RU')}, прибыль {profit[i].toLocaleString('ru-RU')} млн ₽</title><rect x={48+i*55} y={182-revenue[i]*26} width="18" height={revenue[i]*26} rx="3" class="bar-plan"/><rect x={69+i*55} y={182-profit[i]*26} width="12" height={profit[i]*26} rx="2" class="bar-fact"/><text x={63+i*55} y="209" text-anchor="middle" class="chart-label">{month}</text></g>)}
          </svg></div>
          <details class="dashboard-table-details"><summary>План-факт по проектам <Icon name="plus"/></summary><div class="report-table-wrap"><table class="report-table"><caption>Отдельный пример · тыс. ₽</caption><thead><tr><th scope="col">Проект</th><th scope="col">План</th><th scope="col">Факт</th><th scope="col">Отклонение</th></tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row.name}</th><td>{row.plan}</td><td>{row.fact}</td><td>{row.fact-row.plan>0?'+':'−'}{Math.abs(row.fact-row.plan)}</td></tr>)}</tbody><tfoot><tr><th scope="row">Итого</th><td>240</td><td>236</td><td>−4</td></tr></tfoot></table></div></details>
        </div>
        <div role="tabpanel" id="panel-model" aria-labelledby="tab-model" data-panel="model" tabindex="0" hidden><div class="report-heading"><h3>Сценарии бизнеса</h3><span>млн ₽</span></div><p class="report-explainer">Как результат зависит от выручки, затрат и загрузки.</p><div class="scenario-bars">{[{title:'Базовый',value:12,width:60},{title:'Рост',value:16,width:80},{title:'Стресс',value:7,width:35}].map(item=><div><span>{item.title}</span><div><i style={'width:'+item.width+'%'}></i></div><strong>{item.value}</strong></div>)}</div><p class="report-explainer">Проверяем финансовый результат, денежный поток и потребность в оборотном капитале при разных условиях.</p></div>
        <div role="tabpanel" id="panel-budget" aria-labelledby="tab-budget" data-panel="budget" tabindex="0" hidden><div class="report-heading"><h3>Бюджет денежных потоков</h3><span>тыс. ₽</span></div><p class="report-explainer">Поступления, платежи и остаток на конец месяца.</p><div class="report-table-wrap"><table class="report-table budget-table"><caption class="sr-only">Пример бюджета денежных потоков</caption><thead><tr><th scope="col">Показатель</th><th scope="col">Янв</th><th scope="col">Фев</th><th scope="col">Мар</th></tr></thead><tbody><tr><th scope="row">Поступления</th><td>800</td><td>900</td><td>950</td></tr><tr><th scope="row">Платежи</th><td>750</td><td>820</td><td>870</td></tr><tr><th scope="row">Поток</th><td>50</td><td>80</td><td>80</td></tr></tbody><tfoot><tr><th scope="row">Остаток</th><td>150</td><td>230</td><td>310</td></tr></tfoot></table></div><p class="report-explainer">Начальный остаток — 100 тыс. ₽.</p></div>
        <p class="demo-note">Демонстрация · условные данные</p>
      </div>
    </div>
  </div>
</section>
