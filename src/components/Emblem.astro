const drawing=(drawings[name]??drawings.document).replaceAll('@gold','url(#'+uid+'-gold)').replaceAll('@green','url(#'+uid+'-green)').replaceAll('@paper','url(#'+uid+'-paper)');
---
<svg class={'emblem '+className} width="96" height="96" viewBox="0 0 96 100" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id={uid+'-gold'} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f9e3a1"/><stop offset=".35" stop-color="#d4ad54"/><stop offset=".6" stop-color="#f0d384"/><stop offset="1" stop-color="#9a7131"/></linearGradient>
  <linearGradient id={uid+'-green'} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#427865"/><stop offset=".4" stop-color="#204f41"/><stop offset="1" stop-color="#0b302b"/></linearGradient>
  <linearGradient id={uid+'-paper'} x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fffdf2"/><stop offset="1" stop-color="#dfdfca"/></linearGradient>
  <filter id={uid+'-shadow'} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
 </defs>
 <ellipse cx="48" cy="91" rx="33" ry="4" fill="#0e3029" opacity=".13" filter={'url(#'+uid+'-shadow)'}/>
 <g set:html={drawing}/>
</svg>
