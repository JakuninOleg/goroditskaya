---
import { articles,articleHref } from '../data/articles';
import Icon from './Icon.astro';
import EditorialArt from './EditorialArt.astro';
import { articleMinutes,minuteLabel } from '../data/editorial';
import '../styles/articles.css';
import '../styles/home-stories.css';
interface Props { service?:string; caseSlug?:string; limit?:number; home?:boolean; branded?:boolean; }
const { service,caseSlug,limit=3,home=false,branded=false }=Astro.props;
const selected=articles.filter(article=>(!service||article.relatedServices.includes(service))&&(!caseSlug||article.relatedCases?.includes(caseSlug)))
  .sort((a,b)=>service?a.relatedServices.indexOf(service)-b.relatedServices.indexOf(service):0).slice(0,limit);
---
{selected.length>0&&(home||branded?<section class="section home-reading" aria-labelledby="home-reading-heading"><div class="container">
  <div class="home-reading-heading"><div><h2 id="home-reading-heading">Разобраться в причине</h2><p>Что стоит за цифрами и с чего начать проверку.</p></div><a class="text-link" href="/stati/">Все материалы <Icon/></a></div>
  <div class:list={['home-reading-grid',{'reading-single':selected.length===1}]}>{selected.map((article,index)=><a class:list={['home-reading-story',{'home-reading-feature':index===0}]} href={articleHref(article.slug)}>
    {index===0&&<div class="home-reading-art"><EditorialArt kind={article.diagram} compact/></div>}
    <div class="home-reading-copy"><p class="home-reading-time">{minuteLabel(articleMinutes(article))}</p><h3>{article.title}</h3><p class="home-reading-description">{article.description}</p><span class="home-story-action"><span>Подробнее</span><span class="home-story-arrow"><Icon/></span></span></div>
  </a>)}</div>
</div></section>:<section class="inner-section container article-related"><div class="section-intro"><h2>Разобраться в причине</h2><p>Материалы о данных, расчётах и решениях, с которых начинается работа.</p></div><div class="article-links">{selected.map(article=><a href={articleHref(article.slug)}><h3>{article.title}</h3><p>{article.description}</p><span class="text-link">Подробнее <Icon/></span></a>)}</div></section>)}
