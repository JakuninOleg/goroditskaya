---
interface Props { class?: string; footer?: boolean; href?: string; }
const { class: className, footer = false, href = '#top' } = Astro.props;
---
<a class:list={['brand', { 'brand--footer': footer }, className]} href={href} aria-label="Наталья Городицкая — на главную">
  <img class="brand-mark" src="/brand/natalia-mark.svg" width="210" height="210" alt="" decoding="async"/>
  <span class="brand-copy">
    <strong class="brand-name"><span>Наталья</span><span>Городицкая</span></strong>
    <span class="brand-role">Финансовый директор<span class="brand-role-tail"> на аутсорсе</span></span>
  </span>
</a>
<style>
  .brand{display:inline-flex;align-items:center;gap:14px;flex-shrink:0;max-width:none;color:#0f3d33;text-decoration:none}
  .brand-mark{display:block;width:58px;height:58px;flex-shrink:0;transition:transform 180ms ease}
  .brand-copy{display:block;min-width:0;margin:0;color:inherit}
  .brand-name{display:block;font:400 24px/1.1 var(--serif);letter-spacing:-.045em;white-space:nowrap}
  .brand-name>span{display:block}
  .brand-role{display:block;margin-top:6px;font:400 13px/1.4 var(--sans);letter-spacing:.005em;white-space:nowrap}
  .brand:hover .brand-mark{transform:translateY(-1px)}
  .brand--footer .brand-mark{width:68px;height:68px}
  .brand--footer .brand-name{font-size:27px}
  .brand--footer .brand-role{font-size:13px}
  @media(max-width:1180px){
    .brand{gap:12px}
    .brand-mark{width:52px;height:52px}
    .brand-name{font-size:23px}
  }
  @media(max-width:640px){
    .brand{gap:9px;flex:0 1 auto;max-width:calc(100% - 56px);align-self:center}
    .brand-mark{width:38px;height:48px}
    .brand-name{font-size:20px;line-height:1.08;letter-spacing:-.055em}
    .brand-role{font-size:13px;margin-top:5px}
    .brand-role-tail{display:none}
    .brand--footer{max-width:none}
    .brand--footer .brand-mark{width:52px;height:62px}
    .brand--footer .brand-name{font-size:25px}
    .brand--footer .brand-role{font-size:12px}
    .brand--footer .brand-role-tail{display:inline}
  }
  @media(prefers-reduced-motion:reduce){.brand-mark{transition:none}.brand:hover .brand-mark{transform:none}}
</style>
