---
import PageLayout from '../../layouts/PageLayout.astro';
import HeroArtwork from '../../components/HeroArtwork.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseIllustration from '../../components/CaseIllustration.astro';
import Icon from '../../components/Icon.astro';
import PageCta from '../../components/PageCta.astro';
import StoryCard from '../../components/StoryCard.astro';
import { caseArtKind } from '../../data/editorial';
import { caseStudies,caseHref } from '../../data/cases';
import '../../styles/cases.css';
import '../../styles/publication.css';
---
<PageLayout title="Кейсы финансового директора: производство, ИТ и строительство" description="Обезличенные кейсы Натальи Городицкой: финансовое управление, 1С ERP, восстановление учёта, НИОКР, финансирование и подготовка к due diligence.">
 <div class="publication">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Кейсы'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><h1>За цифрой — конкретная работа</h1><p class="inner-lead">Восстановление учёта, внедрение 1С и работа с финансированием в производстве, ИТ и строительстве. В каждом кейсе — задача компании, моя роль и результат.</p></div><HeroArtwork name="case-library" caption="Проблема · Решение · Результат"/></div></div></section>
  <section class="inner-section container"><div class="case-feature"><div><p class="eyebrow">Разработки · НИОКР · Активы</p><h2>Технология, которая была скрыта в расходах</h2><p class="case-amount">62 млн ₽</p><p>Затраты на результативные разработки были проанализированы и отнесены к НИОКР. Созданная технология и патенты стали видны в составе активов компании.</p><a class="text-link" href="/kejsy/niokr-62-mln/">Читать: проблема, решение и результат <Icon/></a></div><div class="case-art"><CaseIllustration/></div></div></section>
  <section class="inner-section case-catalog-band"><div class="container"><h2>Производство, проекты и финансовая система</h2><p class="case-archive-intro">В одном проекте часто приходится решать несколько задач: восстанавливать учёт, настраивать 1С и готовить отчётность. В кейсах эти задачи разобраны отдельно.</p><div class="story-grid">{caseStudies.filter(study=>study.slug!=='niokr-62-mln').map(study=><StoryCard href={caseHref(study.slug)} title={study.title} description={study.summary} context={study.sector+' · '+study.period} kind={caseArtKind(study.slug)} cta="Проблема, действия и результат" heading="h3"/>)}</div></div></section>
  <PageCta title="Есть похожая задача?" text="Обсудим, какие данные есть у вашей компании, что потребуется проверить и какой результат нужен собственнику."/>
 </div>
</PageLayout>
