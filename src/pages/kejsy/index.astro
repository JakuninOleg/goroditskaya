---
import PageLayout from '../../layouts/PageLayout.astro';
import HeroArtwork from '../../components/HeroArtwork.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseIllustration from '../../components/CaseIllustration.astro';
import Icon from '../../components/Icon.astro';
import PageCta from '../../components/PageCta.astro';
import { caseStudies,caseHref } from '../../data/cases';
import '../../styles/cases.css';
---
<PageLayout title="Кейсы финансового директора: производство, ИТ и строительство" description="Обезличенные кейсы Натальи Городицкой: финансовое управление, 1С ERP, восстановление учёта, НИОКР, финансирование и подготовка к due diligence.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Кейсы'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><h1>За цифрой — конкретная работа</h1><p class="inner-lead">Задачи из опыта Натальи в производстве, ИТ и строительстве. Названия компаний скрыты; в каждом разборе — её роль, выполненная работа и результат.</p></div><HeroArtwork name="case-library" caption="Проблема · Решение · Результат"/></div></div></section>
  <section class="inner-section container"><div class="case-feature"><div><p class="eyebrow">Разработки · НИОКР · Активы</p><h2>Технология, которая была скрыта в расходах</h2><p class="case-amount">62 млн ₽</p><p>Затраты на результативные разработки были проанализированы и отнесены к НИОКР. Созданная технология и патенты стали видны в составе активов компании.</p><a class="text-link" href="/kejsy/niokr-62-mln/">Читать: проблема, решение и результат <Icon/></a></div><div class="case-art"><CaseIllustration/></div></div></section>
  <section class="inner-section case-catalog-band"><div class="container"><h2>Производство, проекты и финансовая система</h2><p class="case-archive-intro">Работа в финансовой функции затрагивает несколько задач одновременно. Отдельные разборы показывают разные стороны одного проекта: учёт, бюджет, автоматизацию или проверку инвестора.</p><div class="case-links">{caseStudies.filter(study=>study.slug!=='niokr-62-mln').map(study=><a class="case-link" href={caseHref(study.slug)}><p class="case-link-context">{study.sector} · {study.period}</p><h3>{study.title}</h3><p>{study.summary}</p><span class="text-link">Проблема, действия и результат <Icon/></span></a>)}</div></div></section>
  <PageCta title="Есть похожая задача?" text="Обсудим, какие данные есть у вашей компании, что потребуется проверить и какой результат нужен собственнику."/>
</PageLayout>
