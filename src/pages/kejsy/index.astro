---
import PageLayout from '../../layouts/PageLayout.astro';
import HeroArtwork from '../../components/HeroArtwork.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseIllustration from '../../components/CaseIllustration.astro';
import Icon from '../../components/Icon.astro';
import PageCta from '../../components/PageCta.astro';
---
<PageLayout title="Кейс: учёт разработок и НИОКР" description="Как анализ затрат на разработки изменил финансовую картину компании: 62 млн ₽ отнесены к результативным НИОКР. Проблема, действия и результат работы.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Кейс'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><p class="eyebrow">Из практики</p><h1>За цифрой — конкретная работа</h1><p class="inner-lead">Кейс о том, как разобраться в расходах, найти созданный результат и отразить его в финансовой картине бизнеса.</p></div><HeroArtwork name="case-library" caption="Проблема · Решение · Результат"/></div></div></section>
  <section class="inner-section container"><div class="case-feature"><div><p class="eyebrow">Разработки · НИОКР · Активы</p><h2>Технология, которая была скрыта в расходах</h2><p class="case-amount">62 млн ₽</p><p>Затраты на результативные разработки были проанализированы и отнесены к НИОКР. Созданная технология и патенты стали видны в составе активов компании.</p><a class="text-link" href="/kejsy/niokr-62-mln/">Читать: проблема, решение и результат <Icon/></a></div><div class="case-art"><CaseIllustration/></div></div></section>
  <PageCta title="Есть похожая задача?" text="Обсудим, какие затраты и результаты разработок есть у вашей компании и что потребуется проверить." service="НИОКР и НМА"/>
</PageLayout>
