---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseStudyMap from '../../components/CaseStudyMap.astro';
import RelatedCases from '../../components/RelatedCases.astro';
import PageCta from '../../components/PageCta.astro';
import Icon from '../../components/Icon.astro';
import EditorialArt from '../../components/EditorialArt.astro';
import ReadingNav from '../../components/ReadingNav.astro';
import ReadingByline from '../../components/ReadingByline.astro';
import { caseArtKind,caseMinutes } from '../../data/editorial';
import { caseStudies,caseHref,type CaseStudy } from '../../data/cases';
import { services,serviceHref } from '../../data/services';
import '../../styles/cases.css';
import '../../styles/publication.css';
export function getStaticPaths(){return caseStudies.filter(study=>study.slug!=='niokr-62-mln').map(study=>({params:{slug:study.slug},props:{study}}));}
interface Props { study:CaseStudy; }
const {study}=Astro.props;
const related=study.services.map(slug=>services.find(service=>service.slug===slug)!).filter(Boolean);
const origin=Astro.site!;
const structuredData=[
  {'@context':'https://schema.org','@type':'Article',headline:study.title,description:study.description,inLanguage:'ru-RU',mainEntityOfPage:new URL(caseHref(study.slug),origin).href,author:{'@type':'Person',name:'Наталья Городицкая',url:new URL('/o-natale/',origin).href}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Главная',item:new URL('/',origin).href},{name:'Кейсы',item:new URL('/kejsy/',origin).href},{name:study.title,item:new URL(caseHref(study.slug),origin).href}].map((item,i)=>({'@type':'ListItem',position:i+1,...item}))},
];
---
<PageLayout title={study.title} description={study.description} structuredData={structuredData}>
 <div class="publication">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Кейсы',href:'/kejsy/'},{label:study.sector}]}/>
    <div class="inner-hero-grid story-hero-grid"><div><p class="case-context">{study.sector}{study.period&&<> · {study.period}</>}</p><h1>{study.title}</h1><p class="inner-lead">{study.summary}</p><ReadingByline minutes={caseMinutes(study)}/><div class="inner-actions"><a class="button button-yellow" href="#request">Обсудить похожую задачу <Icon/></a><a class="text-link" href="#case-result">К результату <Icon/></a></div></div><div class="case-hero-visual"><EditorialArt kind={caseArtKind(study.slug)}/>{study.focus&&<p class="case-hero-fact"><strong>{study.focus.value}</strong><span>{study.focus.label}</span></p>}</div></div>
  </div></section>
  <div class="container reading-layout case-reading"><ReadingNav links={[{id:'case-role',title:'Роль Натальи'},{id:'case-problem',title:'Задача'},{id:'case-work',title:'Что было сделано'},{id:'case-result',title:'Результат'}]}/><article class="reading-body">
    <section class="reading-role" id="case-role"><h2>Роль Натальи в проекте</h2><p>{study.role}</p></section>
    <section id="case-problem"><h2>Задача</h2>{study.problem.map(text=><p>{text}</p>)}<CaseStudyMap items={study.map}/></section>
    <section id="case-work"><h2>Что было сделано</h2><ol class="case-actions">{study.actions.map(action=><li><div><h3>{action.title}</h3><p>{action.text}</p></div></li>)}</ol></section>
    <section class="case-study-result" id="case-result"><h2>Результат</h2><ul>{study.results.map(result=><li><Icon name="check"/><span>{result}</span></li>)}</ul><p>{study.conclusion}</p></section>
  </article></div>
  <section class="inner-section container case-service-links"><h2>Помощь с похожей задачей</h2><div class="case-service-list">{related.map(service=><a href={serviceHref(service.slug)}><span>{service.short}</span><Icon/></a>)}</div></section>
  <RelatedCases services={study.services} exclude={study.slug} illustrated/>
  <PageCta title="Разберём вашу задачу по данным компании" text="Расскажите, что сейчас мешает работе. Обсудим исходные данные, результат и подходящий состав проекта." service={related[0]?.title}/>
 </div>
</PageLayout>
