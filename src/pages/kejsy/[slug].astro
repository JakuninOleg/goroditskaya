---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseStudyMap from '../../components/CaseStudyMap.astro';
import RelatedCases from '../../components/RelatedCases.astro';
import PageCta from '../../components/PageCta.astro';
import Icon from '../../components/Icon.astro';
import { caseStudies,caseHref,type CaseStudy } from '../../data/cases';
import { services,serviceHref } from '../../data/services';
import '../../styles/cases.css';
export function getStaticPaths(){return caseStudies.filter(study=>study.slug!=='niokr-62-mln').map(study=>({params:{slug:study.slug},props:{study}}));}
interface Props { study:CaseStudy; }
const {study}=Astro.props;
const related=study.services.map(slug=>services.find(service=>service.slug===slug)!).filter(Boolean);
const origin=Astro.site!;
const structuredData=[
  {'@context':'https://schema.org','@type':'Article',headline:study.title,description:study.description,inLanguage:'ru-RU',mainEntityOfPage:new URL(caseHref(study.slug),origin).href,author:{'@type':'Person',name:'Наталья Городицкая',url:new URL('/o-natale/',origin).href}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Главная',item:new URL('/',origin).href},{name:'Кейсы',item:new URL('/kejsy/',origin).href},{name:study.title,item:new URL(caseHref(study.slug),origin).href}].map((item,i)=>({'@type':'ListItem',position:i+1,...item}))},
];
---
<PageLayout title={study.title} description={study.description} structuredData={structuredData}>
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Кейсы',href:'/kejsy/'},{label:study.sector}]}/>
    <div class="inner-hero-grid case-study-hero"><div><p class="case-context">{study.sector}{study.period&&<> · {study.period}</>}</p><h1>{study.title}</h1><p class="inner-lead">{study.summary}</p><div class="inner-actions"><a class="button button-yellow" href="#request">Обсудить похожую задачу <Icon/></a><a class="text-link" href="#case-result">К результату <Icon/></a></div></div><CaseStudyMap items={study.map} focus={study.focus}/></div>
  </div></section>
  <section class="inner-section container case-role"><h2>Роль Натальи в проекте</h2><p>{study.role}</p></section>
  <section class="inner-section case-problem"><div class="container case-reading-layout"><h2>Задача</h2><div>{study.problem.map(text=><p>{text}</p>)}</div></div></section>
  <section class="inner-section container"><div class="case-reading-layout"><h2>Что было сделано</h2><div class="case-actions">{study.actions.map(action=><article><h3>{action.title}</h3><p>{action.text}</p></article>)}</div></div></section>
  <section class="inner-section case-study-result" id="case-result"><div class="container case-reading-layout"><h2>Результат</h2><div><ul>{study.results.map(result=><li><Icon name="check"/><span>{result}</span></li>)}</ul><p>{study.conclusion}</p></div></div></section>
  <section class="inner-section container case-service-links"><h2>Помощь с похожей задачей</h2><div class="case-service-list">{related.map(service=><a href={serviceHref(service.slug)}><span>{service.short}</span><Icon/></a>)}</div></section>
  <RelatedCases services={study.services} exclude={study.slug}/>
  <PageCta title="Разберём вашу задачу по данным компании" text="Расскажите, что сейчас мешает работе. Обсудим исходные данные, результат и подходящий состав проекта." service={related[0]?.title}/>
</PageLayout>
