---
import PageLayout from '../layouts/PageLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<PageLayout title="Контакты и консультации" description="Консультации команды Натальи Городицкой по финансовым задачам бизнеса. Работа по всей России: управленческий учёт, финансовая модель, 1С, налоговое сопровождение.">
  <section class="contact-page container"><Breadcrumbs items={[{label:'Контакты'}]}/><div class="contact-page-grid"><div><p class="eyebrow">Связаться с Натальей</p><h1>Начнём с вашего вопроса</h1><p class="inner-lead">Расскажите, что сейчас происходит в бизнесе и какое решение предстоит принять. Предложим подходящий формат разбора и состав работ.</p><div class="contact-direct"><a href={'mailto:'+site.email}><Icon name="mail"/>{site.email}</a><a href={'tel:'+site.phoneHref}><Icon name="phone"/>{site.phone}</a></div><HeroArtwork name="contact" class="contact-artwork"/></div><div id="request"><ContactForm standalone/></div></div><div class="contact-scope contact-afterword"><div><strong>Работаем по всей России</strong><p>Встречи и работа с командой могут проходить онлайн. Состав участников и порядок взаимодействия согласуем под проект.</p></div><div><strong>Передача рабочих материалов</strong><p>Для первого обращения достаточно контакта для связи. Рабочие документы и доступы передаются после согласования конфиденциальности и способа обмена.</p></div></div></section>
</PageLayout>
<style>.contact-afterword{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:0;margin-bottom:60px}.contact-afterword p{margin-top:12px}@media(max-width:640px){.contact-afterword{grid-template-columns:1fr;gap:25px;margin-bottom:45px}}</style>
