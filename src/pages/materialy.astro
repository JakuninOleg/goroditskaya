---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const materials=[{title:'ДДС на 13 недель',icon:'payments',text:'Планируйте поступления и платежи по неделям. Остаток денег показывает, в какой момент потребуется изменить график оплат или найти источник покрытия.',items:['Поступления, платежи и остаток','Краткосрочный горизонт планирования','Основа для разговора о кассовом разрыве'],headers:['Неделя','Приход','Расход','Остаток']},{title:'Прибыль по проектам',icon:'profit',text:'Сопоставляйте доходы и затраты направлений. Форма помогает начать разговор о себестоимости и о том, какой результат даёт каждый проект.',items:['Доходы и затраты по проектам','Финансовый результат направлений','Проверка полноты учтённых расходов'],headers:['Проект','Доход','Затраты','Прибыль']},{title:'План-факт бюджета',icon:'clarity',text:'Сравнивайте план с фактом по согласованным статьям. Отклонение — повод найти причину и определить действие, а не просто выделить ячейку цветом.',items:['Единые статьи плана и факта','Отклонения по показателям','Основа для регулярного разбора'],headers:['Статья','План','Факт','Отклонение']}];
---
<PageLayout title="Финансовые формы для собственника" description="Комплект Excel-форм: ДДС на 13 недель, прибыль по проектам и план-факт бюджета. Оставьте почту и телефон, чтобы получить материалы.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Финансовые формы'}]}/><div class="catalog-intro"><p class="eyebrow">Инструменты собственника</p><h1>Начните с понятных форм</h1><p class="inner-lead">Три Excel-шаблона для первого порядка в деньгах, проектах и бюджете. Оставьте рабочую почту и телефон — запрошенный комплект придёт на почту.</p><div class="inner-actions"><a class="button button-yellow" href="#get-forms">Получить комплект <Icon/></a></div></div></div></section>
  <section class="inner-section container"><div class="materials-layout"><div class="material-list">{materials.map(m=><article class="material-item"><Emblem name={m.icon}/><div><h2>{m.title}</h2><p>{m.text}</p><ul>{m.items.map(item=><li>{item}</li>)}</ul><div class="blank-sheet" aria-hidden="true"><div>{m.headers.map(h=><span>{h}</span>)}</div>{[1,2,3].map(()=> <div>{m.headers.map(()=> <i></i>)}</div>)}</div></div></article>)}</div><aside class="materials-form" id="get-forms"><p class="eyebrow">Комплект Excel</p><h2>Пришлите формы на почту</h2><p>ДДС, прибыль проектов и план-факт бюджета в одном комплекте.</p><form id="templates-form" action={'mailto:'+site.email} method="post" enctype="text/plain"><label for="templates-email">Рабочая почта <span aria-hidden="true">*</span><input id="templates-email" name="email" type="email" autocomplete="email" placeholder="name@company.ru" maxlength="254" required/></label><label for="templates-phone">Телефон <span aria-hidden="true">*</span><input id="templates-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" maxlength="18" required/></label><label class="consent-label"><input type="checkbox" name="consent" required/><span>Согласен с <button type="button" class="inline-link" data-privacy-open>политикой обработки персональных данных</button></span></label><button class="button button-yellow" type="submit">Получить формы на почту <Icon/></button></form></aside></div></section>
  <section class="inner-section situation-section"><div class="container section-intro"><h2>Форма помогает начать. Систему строим под бизнес.</h2><p>Если показатели не сходятся, данные собираются вручную или нужна аналитика по группе компаний, начнём с <a class="inline-link" href="/finansovaya-diagnostika/">финансовой диагностики</a> и определим подходящую структуру учёта.</p></div></section>
</PageLayout>
<script>import '../scripts/contact';</script>
<style>.blank-sheet{margin-top:22px;border:1px solid #c4d2bc;border-radius:7px;overflow:hidden;background:#faf9f0}.blank-sheet>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.blank-sheet span{background:#e4ebdc;font-size:11px;font-weight:500;padding:10px 6px;border-right:1px solid #c4d2bc;overflow-wrap:anywhere}.blank-sheet i{height:27px;border-top:1px solid #d7decc;border-right:1px solid #d7decc}.materials-form .eyebrow{color:#cbd9bd}@media(max-width:640px){.blank-sheet span{font-size:10px;padding:8px 4px}.blank-sheet i{height:24px}}</style>
