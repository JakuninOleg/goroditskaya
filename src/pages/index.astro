---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FinancialMap from '../components/FinancialMap.astro';
import { site, questions, services, steps, faq } from '../data/site';
---
<Layout>
  <a class="skip-link" href="#main">К содержанию</a>
  <header class="header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="Наталья Городицкая — на главную">
        <span class="brand-name">{site.latinName}</span>
        <span class="brand-role">{site.role}</span>
      </a>
      <nav class="desktop-nav" aria-label="Основная навигация">
        <a href="#tasks">Задачи</a><a href="#services">Решения</a><a href="#approach">Подход</a><a href="#experience">Опыт</a>
      </nav>
      <a class="header-cta" href="#contact"><span>Обсудить задачу</span><span class="round-arrow"><Icon /></span></a>
      <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Мобильная навигация" hidden>
      <a href="#tasks">Задачи собственника</a><a href="#services">Решения для бизнеса</a><a href="#approach">Подход к работе</a><a href="#experience">Опыт Натальи</a><a href="#contact">Обсудить задачу <Icon /></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Финансовый директор для вашего бизнеса</p>
        <h1>Видеть бизнес<br />целиком<span class="lime-dot">.</span><br />Управлять точнее<span class="lime-dot">.</span></h1>
        <p class="hero-description">Помогаю собственникам среднего и крупного бизнеса понимать свои цифры и принимать обоснованные решения.</p>
        <div class="hero-actions"><a class="button" href="#contact">Обсудить задачу <Icon /></a><span class="action-note">Личное ведение проектов.<br />Работа по всей России.</span></div>
      </div>
      <FinancialMap />
      <div class="hero-foot"><span>Наталья Городицкая · Финансы, учёт и развитие</span><a href="#tasks">Начнём с ваших вопросов <span>↓</span></a></div>
    </section>

    <section class="section tasks-section" id="tasks">
      <div class="container">
        <div class="section-top"><p class="eyebrow">01 / Задачи собственника</p><span class="section-note">От вопроса — к понятным цифрам</span></div>
        <div class="section-intro"><h2>Бизнес растёт.<br />Ясности должно<br />быть больше<span class="lime-dot">.</span></h2><p>Финансовая отчётность должна объяснять, что происходит в бизнесе, и помогать выбрать следующий шаг.</p></div>
        <div class="question-grid">
          {questions.map((question, i) => <article class="question-card"><span class="question-number">0{i + 1}</span><p class="micro-label">{question.tag}</p><h3>{question.title}</h3><p>{question.text}</p><a href="#financial-model" aria-label={`Как решить задачу: ${question.title}`} class="text-link">Разобраться в цифрах <Icon /></a></article>)}
        </div>
        <div class="tasks-note"><span class="note-mark">↳</span><p>Финансовая модель просчитывает сценарии. Управленческая отчётность показывает фактический результат и отклонения от плана.</p></div>
      </div>
    </section>

    <section class="section services-section" id="services">
      <div class="container">
        <div class="section-top"><p class="eyebrow">02 / Решения для бизнеса</p><span class="section-note">От отдельной задачи до финансовой системы</span></div>
        <h2 class="services-title">Порядок в цифрах.<br />Основа для решений<span class="lime-dot">.</span></h2>
        <article class="model-feature" id="financial-model">
          <div class="model-feature-copy"><p class="micro-label">01 / Финансовое управление</p><h3>Ваш бизнес.<br />В одной модели.</h3><p>Связываем выручку, затраты, денежные потоки и обязательства. Показываем, как решения о росте, найме и инвестициях меняют финансовый результат.</p><button class="button" data-open-brief data-task="Финансовая модель и управленческая отчётность">Обсудить финансовую модель <Icon /></button></div>
          <div class="model-outline">
            <div class="outline-title"><span>ФИНАНСОВАЯ МОДЕЛЬ</span><span>↗</span></div>
            <div class="outline-row"><span class="outline-icon">₽</span><div><strong>Деньги</strong><span>ДДС · Платёжный календарь</span></div><Icon name="check" /></div>
            <div class="outline-row"><span class="outline-icon">↗</span><div><strong>Прибыль</strong><span>Доходы · Себестоимость · Проекты</span></div><Icon name="check" /></div>
            <div class="outline-row"><span class="outline-icon">≈</span><div><strong>Баланс</strong><span>Активы · Обязательства · Капитал</span></div><Icon name="check" /></div>
            <div class="outline-result"><span class="status-dot"></span><span>План → факт → решение</span></div>
          </div>
        </article>
        <div class="service-stack">
          {services.map(service => <article class="service-panel" id={service.id}>
            <div class="service-heading"><span class="service-number">{service.number}</span><p class="micro-label">{service.label}</p><h3>{service.title}</h3></div>
            <div class="service-content"><p>{service.text}</p><ul class="deliverables">{service.bullets.map(item => <li><span></span>{item}</li>)}</ul><details class="service-details"><summary>Что входит в работу <Icon name="plus" /></summary><p>{service.detail}</p><button class="text-link" data-open-brief data-task={service.label}>Обсудить эту задачу <Icon /></button></details></div>
          </article>)}
        </div>
        <div class="complex-work"><div><p class="micro-label">СЛОЖНЫЕ КОНТУРЫ</p><h3>Когда цена ошибки высока.</h3><p>Отдельно прорабатываем задачи, требующие внимания к документам, регламентам и рискам.</p></div><div class="complex-items"><details><summary>Раздельный учёт по ГОЗ, 275-ФЗ <Icon name="plus" /></summary><p>Методология раздельного учёта, распределение затрат и подготовка учётной базы по конкретным контрактам.</p></details><details><summary>Выездные налоговые проверки <Icon name="plus" /></summary><p>Финансовая и учётная подготовка, сбор доказательной базы. Процессуальные вопросы и споры ведём с профильным налоговым юристом.</p></details></div></div>
      </div>
    </section>

    <section class="section approach-section" id="approach">
      <div class="container approach-grid">
        <div class="approach-intro"><p class="eyebrow">03 / Подход к работе</p><h2>От данных<br />к работающему<br />решению<span class="lime-dot">.</span></h2><p>На каждом этапе понятны цель, результат и следующий шаг. Вы общаетесь со специалистом, который ведёт ваш проект.</p><a href="#contact" class="text-link">Начать с обсуждения <Icon /></a></div>
        <ol class="timeline">{steps.map((step,i) => <li><span class="step-number">0{i+1}</span><div><h3>{step.title}</h3><p>{step.text}</p><span class="step-result">{step.result}</span></div></li>)}</ol>
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <div class="container">
        <div class="section-top"><p class="eyebrow">04 / Практический опыт</p><span class="section-note">ИТ · Производство · Строительство</span></div>
        <div class="section-intro"><h2>За решениями —<br />реальный опыт<span class="lime-dot">.</span></h2><p>Финансовое управление внутри компаний: от восстановления учёта до моделей для инвесторов и внедрения ERP.</p></div>
        <div class="experience-facts"><div><span class="fact-value">С 1996<span>года</span></span><p>в финансах и учёте</p></div><div><span class="fact-value">50+<span>специалистов</span></span><p>в отделе под руководством</p></div><div><span class="fact-value">1С ERP</span><p>опыт внедрения в производстве</p></div></div>
        <div class="experience-projects">
          <article><p class="micro-label">ПРОИЗВОДСТВО / 2022–2024</p><h3>Связать учёт<br />и производство.</h3><p>Восстановление учёта, внедрение 1С ERP, финансовая модель на три года и подготовка к due diligence.</p><div class="project-tags"><span>1С ERP</span><span>Управленческий учёт</span><span>ГОЗ</span></div></article>
          <article><p class="micro-label">ИТ / 2015–2020</p><h3>Управлять финансами<br />проектного бизнеса.</h3><p>Работа с проектными финансами, восстановление учёта и сопровождение проверок в группе ИТ-компаний.</p><div class="project-tags"><span>Проектные финансы</span><span>Группа компаний</span></div></article>
        </div>
      </div>
    </section>

    <section class="section about-section" id="about">
      <div class="container about-grid">
        <figure class="portrait"><img src="/images/natalia.png" width="327" height="500" alt="Наталья Городицкая" loading="lazy" decoding="async" /><figcaption><span class="status-dot"></span> Лично веду каждый проект</figcaption></figure>
        <div class="about-copy"><p class="eyebrow">05 / Личный подход</p><h2>Наталья<br />Городицкая<span class="lime-dot">.</span></h2><p class="about-role">Финансовый директор · Эксперт по учёту</p><p class="about-lead">Помогаю собственнику увидеть бизнес целиком: разобраться в финансовой картине, выстроить надёжный учёт и оценить следующие решения.</p><p>Мой опыт соединяет финансовое управление, бухгалтерский учёт и внедрение систем. Поэтому модель опирается на реальные данные компании, а отчёты учитывают её процессы.</p><div class="personal-note"><span>↳</span><p>Веду проект лично. Под конкретную задачу подключаю интеграторов 1С, юристов и других профильных специалистов.</p></div><a class="text-link" href="#contact">Познакомиться и обсудить проект <Icon /></a></div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid"><div><p class="eyebrow">06 / До начала работы</p><h2>Несколько<br />важных вопросов<span class="lime-dot">.</span></h2></div><div class="faq-list">{faq.map(item => <details><summary>{item.question}<Icon name="plus" /></summary><p>{item.answer}</p></details>)}</div></div>
    </section>

    <section class="contact-section" id="contact">
      <div class="container contact-grid"><div><p class="eyebrow"><span class="status-dot"></span> Давайте начнём с вашей задачи</p><h2>Больше ясности.<br />Для следующего<br />решения<span class="lime-dot">.</span></h2></div><div class="contact-copy"><p>Расскажите, что происходит в бизнесе и какой результат вам нужен. Обсудим возможный состав работ и формат сотрудничества.</p><button class="button" data-open-brief>Обсудить задачу <Icon /></button><div class="direct-contacts"><a href={`mailto:${site.email}`}>{site.email} <Icon /></a><a href={`tel:${site.phoneHref}`}>{site.phone}</a><span>Онлайн · Компании по всей России</span></div></div></div>
    </section>
  </main>

  <footer class="footer"><div class="container footer-top"><a href="#top" class="brand"><span class="brand-name">{site.latinName}</span><span class="brand-role">{site.role}</span></a><nav aria-label="Навигация в подвале"><a href="#services">Решения</a><a href="#approach">Подход</a><a href="#experience">Опыт</a><a href="#contact">Контакты</a></nav><a class="back-top" href="#top" aria-label="Вернуться к началу страницы">↑</a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Наталья Городицкая</span><span>Структура сегодня. Устойчивость завтра.</span></div></footer>

  <dialog class="brief-dialog" id="brief-dialog" aria-labelledby="brief-title">
    <button class="dialog-close" aria-label="Закрыть окно"><Icon name="close" /></button>
    <p class="eyebrow">Начало разговора</p><h2 id="brief-title">Расскажите<br />о вашей задаче<span class="lime-dot">.</span></h2>
    <p class="dialog-intro">Подготовим текст письма Наталье. Вы сможете скопировать его или открыть в своей почтовой программе.</p>
    <form id="brief-form">
      <label>Как вас зовут<input name="name" autocomplete="name" required maxlength="100" placeholder="Имя и фамилия" /></label>
      <label>Компания<input name="company" autocomplete="organization" required maxlength="150" placeholder="Название и сфера деятельности" /></label>
      <label>Задача<select name="task"><option>Финансовая модель и управленческая отчётность</option><option>Учёт и отчётность</option><option>НИОКР и нематериальные активы</option><option>Автоматизация на базе 1С</option><option>Банковское финансирование</option><option>Раздельный учёт по ГОЗ</option><option>Налоговая проверка</option><option>Другая задача</option></select></label>
      <label>Что важно решить<textarea name="message" rows="3" maxlength="3000" placeholder="Кратко опишите ситуацию и желаемый результат"></textarea></label>
      <button class="button" type="submit">Подготовить письмо <Icon /></button>
      <p class="form-note" id="form-note" aria-live="polite">Данные не сохраняются на сайте.</p>
    </form>
    <a class="dialog-email" href={`mailto:${site.email}`}>Или напишите напрямую: {site.email}</a>
    <div class="email-fallback" hidden><p>Текст готов. Скопируйте его и отправьте Наталье или откройте письмо в почтовой программе.</p><textarea id="prepared-email" aria-label="Текст подготовленного письма" rows="5" readonly></textarea><div class="prepared-actions"><button class="text-link" id="copy-brief">Скопировать текст <Icon /></button><a class="text-link" id="send-prepared-email" href={`mailto:${site.email}`}>Открыть в почте <Icon /></a></div></div>
  </dialog>
  <script define:vars={{ email: site.email }}>
    const toggle = document.querySelector('.menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label','Открыть меню'); if (mobileNav) mobileNav.hidden = true; };
    toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню'); mobileNav.hidden = !open; });
    mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click',closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
    window.matchMedia('(min-width: 901px)').addEventListener('change',closeMenu);
    const dialog = document.getElementById('brief-dialog');
    const form = document.getElementById('brief-form');
    document.querySelectorAll('[data-open-brief]').forEach(button => button.addEventListener('click', () => {
      const task = button.dataset.task;
      if (task) { const select=form.elements.task; const option=[...select.options].find(o=>o.value.toLowerCase()===task.toLowerCase()); if(option)select.value=option.value; }
      dialog.showModal();
    }));
    document.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
    dialog?.addEventListener('click', e => { if (e.target === dialog) { const r=dialog.getBoundingClientRect(); if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close(); } });
    dialog?.addEventListener('close',()=> { document.querySelector('.email-fallback').hidden=true; document.getElementById('form-note').textContent='Данные не сохраняются на сайте.'; form.reset(); });
    form?.addEventListener('submit', e => {
      e.preventDefault();
      const data=new FormData(form);
      const subject=`Обсуждение проекта: ${data.get('company')}`;
      const body=`Наталья, добрый день!\n\nМеня зовут ${data.get('name')}.\nКомпания: ${data.get('company')}.\nЗадача: ${data.get('task')}.\n\n${data.get('message') || ''}\n\nХочу обсудить возможный состав работ и формат сотрудничества.`;
      document.getElementById('prepared-email').value=body;
      document.querySelector('.email-fallback').hidden=false;
      document.getElementById('form-note').textContent='Текст письма подготовлен. Данные ещё не отправлены.';
      document.getElementById('send-prepared-email').href=`mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      document.getElementById('prepared-email').focus();
    });
    document.getElementById('copy-brief')?.addEventListener('click',async () => { const field=document.getElementById('prepared-email'); try { await navigator.clipboard.writeText(field.value); document.getElementById('form-note').textContent='Текст скопирован. Вставьте его в письмо Наталье.'; } catch { field.focus(); field.select(); document.getElementById('form-note').textContent='Выделенный текст можно скопировать вручную.'; } });
  </script>
</Layout>
