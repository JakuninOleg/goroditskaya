---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Emblem from '../components/Emblem.astro';
import FinancialReport from '../components/FinancialReport.astro';
import Iceberg from '../components/Iceberg.astro';
import { site, products, financeWork, taxWork, formats, specialTasks, faq } from '../data/site';
const processImages = ['diagnostics','system','support'];
const processDescriptions = ['Проверяю данные, нахожу причины и определяю первые изменения.','Связываю учёт, финансовую модель, бюджет и отчётность.','Разбираю отклонения, обновляю прогноз и работаю с командой.'];
const templates = [
 { title:'ДДС на 13 недель', label:'Денежный поток', headers:['Неделя','Приход','Расход','Остаток'],rows:[['01','120','80','40'],['02','180','140','80'],['03','160','130','110']],bars:[32,46,40,60,54,76,68,88],type:'cash'},
 { title:'Прибыль по проектам', label:'Результат направлений', headers:['Проект','Доход','Затраты','Прибыль'],rows:[['А','120','85','35'],['Б','180','140','40'],['В','160','110','50']],bars:[58,72,64,85,76,100],type:'profit'},
 { title:'План-факт бюджета', label:'Контроль отклонений',headers:['Статья','План','Факт','Разница'],rows:[['Доход','150','160','+10'],['Затраты','100','105','+5'],['Прибыль','50','55','+5']],bars:[66,60,86,78,56,64,96,88],type:'budget'}
];
---
<Layout>
<a class="skip-link" href="#main">К содержанию</a>
<header class="masthead" id="top"><div class="masthead-shell container">
 <div class="masthead-row">
  <a class="identity" href="#top" aria-label="Наталья Городицкая — на главную"><span class="identity-name">Наталья<span class="identity-break"></span> Городицкая</span><span class="identity-role">Финансовый директор <span>на аутсорсе</span></span></a>
  <nav class="masthead-nav" aria-label="Основная навигация"><a href="#about">Обо мне</a><a href="#services">Услуги</a><a href="#experience">Кейс</a><a href="#approach">Как я работаю</a></nav>
  <a class="button button-yellow masthead-cta" href="#contact">Обсудить задачу <Icon/></a>
  <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span><span></span></button>
 </div>
 <nav class="masthead-mobile-nav" id="mobile-nav" aria-label="Мобильная навигация" hidden><a href="#tasks">Ваша задача</a><a href="#services">Услуги</a><a href="#experience">Кейс Технорэд</a><a href="#approach">Как я работаю</a><a href="#about">Обо мне</a><a href="#resources">Полезные формы</a><a href="#faq">Вопросы и ответы</a><a href="#contact">Обсудить проект <Icon/></a></nav>
</div></header>
<div class="masthead-scrim" aria-hidden="true" hidden></div>
<main id="main">
<section class="hero" aria-labelledby="hero-heading">
 <div class="hero-stage">
  <picture class="hero-visual"><source media="(max-width:640px)" srcset="/images/hybrid/hero-portrait-640.webp 640w, /images/hybrid/hero-portrait.webp 1120w" sizes="100vw"/><img src="/images/hybrid/hero-office.webp" srcset="/images/hybrid/hero-office-1200.webp 1200w, /images/hybrid/hero-office.webp 1916w" sizes="100vw" width="1916" height="821" alt="Наталья Городицкая за рабочим столом" fetchpriority="high" decoding="async"/></picture>
  <div class="container hero-copy"><div class="hero-text"><h1 id="hero-heading"><span>Видеть бизнес</span><span>целиком.</span><span>Управлять <em>точнее.</em></span></h1><p class="hero-description">Помогаю собственникам навести порядок в финансах, видеть реальную прибыль и принимать решения на основе цифр.</p><a class="button button-yellow hero-cta" href="#contact">Обсудить задачу <Icon/></a></div></div>
 </div>
 <div class="container hero-facts"><div class="hero-fact"><Emblem name="experience"/><div><strong>С {site.experienceSince} года</strong><span>в финансах и учёте</span></div></div><div class="hero-fact"><Emblem name="system"/><div><strong>1С ERP</strong><span>внедрение и сопровождение</span></div></div><div class="hero-fact"><Emblem name="remote"/><div><strong>Вся Россия</strong><span>работаю удалённо</span></div></div></div>
</section>

<Iceberg/>

<section class="section container products-section" id="services" aria-labelledby="products-heading">
 <div class="section-heading"><p class="eyebrow">Экспертиза для вашего бизнеса</p><h2 id="products-heading">Три направления работы</h2></div>
 <div class="products-list">{products.map(product=><article class={'product-card product-'+product.id}><div class="product-art"><img src={'/images/hybrid/service-'+product.id+'.webp'} width="1000" height="750" alt="" loading="lazy" decoding="async"/></div><div class="product-copy"><h3>{product.title} <br/>на аутсорсе</h3><p>{product.text}</p><button class="product-button text-link" type="button" data-product={product.id} aria-haspopup="dialog">Подробнее <Icon/><span class="sr-only">: {product.title}</span></button></div></article>)}</div>
 <p class="products-note"><span></span>Профильных специалистов подключаю под задачу вашего проекта.</p>
</section>

<FinancialReport/>

<section class="section case-section" id="experience" aria-labelledby="case-heading"><div class="container">
 <div class="case-intro"><div class="case-copy"><p class="eyebrow">Кейс · Технорэд</p><h2 id="case-heading">Разработки, которые были скрыты в расходах</h2><p class="case-amount"><span>62</span> млн ₽</p><p class="case-amount-label">затрат отнесены к НИОКР</p></div><div class="case-art"><img src="/images/hybrid/case-dossier.webp" width="1536" height="1024" alt="Иллюстрация: анализ инженерных разработок и документации" loading="lazy" decoding="async"/></div></div>
 <div class="case-steps">
  <article class="case-step"><span class="step-number">01</span><h3>Проблема</h3><p>Затраты на разработки списывались в расходы. Финансовый результат не отражал созданную технологию.</p><Emblem name="document" class="case-step-emblem"/></article>
  <article class="case-step case-step-solution"><span class="step-number">02</span><h3>Решение</h3><p>Проанализировала затраты и документы. Выделила 62 млн ₽ затрат на результативные НИОКР.</p><Emblem name="clarity" class="case-step-emblem"/></article>
  <article class="case-step case-step-result"><span class="step-number">03</span><h3>Результат</h3><p>Технология и патенты отражены как активы. Инвесторы получили более полную финансовую картину.</p><strong class="case-conclusion">Созданные активы стали видны инвесторам.</strong></article>
 </div>
 <p class="case-note">Данные проекта предоставлены Натальей Городицкой. Выделение затрат на НИОКР — изменение учёта, а не поступление денег.</p>
</div></section>

<section class="section container process-section" id="approach" aria-labelledby="formats-heading">
 <div class="section-heading"><p class="eyebrow">От первого вопроса до рабочей системы</p><h2 id="formats-heading">Как я работаю</h2></div>
 <div class="process-grid">{formats.map((format,i)=><article class="process-card"><div class="process-card-title"><span class="step-number">{'0'+(i+1)}</span><h3>{format.label}</h3></div><p class="process-description">{processDescriptions[i]}</p><img class="process-art" src={'/images/hybrid/process-'+processImages[i]+'.webp'} width="900" height="675" alt="" loading="lazy" decoding="async"/><ul class="process-outputs">{format.items.map(item=><li><Icon name="check"/>{item.title}</li>)}</ul><a class="text-link" href="#contact" data-task={format.label}>{format.action} <Icon/></a></article>)}</div>
 <ol class="project-journey" aria-label="Этапы проекта">{['Задача','План','Внедрение','Контроль'].map((step,i)=><li><span aria-hidden="true">{'0'+(i+1)}</span>{step}</li>)}</ol>
</section>

<section class="section special-section" aria-labelledby="special-heading"><div class="container"><div class="section-heading"><p class="eyebrow">Когда нужно разобраться глубже</p><h2 id="special-heading">Для сложных задач</h2></div><div class="special-grid">{specialTasks.map(task=><button class="special-task" type="button" data-info={task.id} aria-haspopup="dialog"><span class="special-art"><img src={'/images/hybrid/special-'+task.id+'.webp'} width="900" height="675" alt="" loading="lazy" decoding="async"/></span><span class="special-task-title">{task.title}</span><span class="special-task-description">{task.text}</span><span class="sr-only"> — подробнее</span></button>)}</div></div></section>

<section class="section container about-section" id="about" aria-labelledby="about-heading">
 <div class="about-portrait"><img src="/images/hybrid/hero-portrait.webp" srcset="/images/hybrid/hero-portrait-640.webp 640w, /images/hybrid/hero-portrait.webp 1120w" sizes="(max-width:760px) 90vw, 40vw" width="1120" height="1400" alt="Наталья Городицкая" loading="lazy" decoding="async"/></div>
 <div class="about-copy"><p class="eyebrow">Личное ведение</p><h2 id="about-heading">Лично веду <br/>ваш проект</h2><p class="about-name">Наталья Городицкая</p><p class="about-lead">Соединяю финансовую модель, учёт и задачи собственника. Подключаю профильных специалистов под проект.</p><div class="about-facts" id="expertise"><div><Emblem name="experience"/><p><strong>С {site.experienceSince} года</strong><span>в финансах и учёте</span></p></div><div><Emblem name="system"/><p><strong>1С ERP</strong><span>внедрение и сопровождение</span></p></div><div><Emblem name="team"/><p><strong>Команды 50+</strong><span>опыт управления специалистами</span></p></div></div><div class="about-principles"><div><Emblem name="clarity"/><span>Понятные отчёты</span></div><div><Emblem name="secure"/><span>Конфиденциальность</span></div><div><Emblem name="personal"/><span>Личное ведение</span></div></div><a class="text-link" href="#contact">Обсудить ваш проект <Icon/></a></div>
</section>

<section class="section resources-section" id="resources" aria-labelledby="resources-heading"><div class="container">
 <div class="resources-heading"><div><p class="eyebrow">Полезное уже сейчас</p><h2 id="resources-heading">Начните с понятных форм</h2><p>Три Excel-шаблона для первых решений.</p></div><div class="resources-action"><a class="button button-yellow" href="/downloads/financial-templates.xlsx" download>Получить комплект <Icon/></a><span>Без регистрации · Excel</span></div></div>
 <div class="template-scene">{templates.map((template,i)=><article class={'template-holder template-'+template.type}><div class="template-sheet"><div class="template-file"><span><Icon name="document"/> XLSX</span><span>{'0'+(i+1)}</span></div><h3>{template.title}</h3><p>{template.label}</p><table class="template-table" aria-label={'Образец: '+template.title}><thead><tr>{template.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{template.rows.map(row=><tr>{row.map((value,n)=>n===0?<th scope="row">{value}</th>:<td>{value}</td>)}</tr>)}</tbody></table><div class="template-chart" aria-hidden="true">{template.bars.map((v,n)=><span style={'--bar:'+v+'%;--i:'+n}></span>)}</div><div class="template-sheet-footer"><span>Рабочая форма</span><Emblem name="document"/></div></div><span class="glass-holder" aria-hidden="true"></span></article>)}</div>
 <ul class="resources-mobile-files">{templates.map(template=><li><Emblem name="document"/>{template.title}</li>)}</ul>
 <div class="resources-bottom"><p>Проверьте денежный поток, прибыль проектов и исполнение бюджета.</p><span>Стартовые формы с инструкцией и формулами.</span></div>
</div></section>

<section class="section container faq-section" id="faq" aria-labelledby="faq-heading"><div class="faq-intro"><p class="eyebrow">Перед началом работы</p><h2 id="faq-heading">Ответы <br/>на частые <br/>вопросы</h2><div class="faq-desk-art" aria-hidden="true"><Emblem name="document"/><Emblem name="secure"/></div></div><div class="faq-list">{faq.map((item,i)=><article class="faq-item" data-faq-item><h3><button type="button" id={'faq-toggle-'+i} aria-expanded={i===0?'true':'false'} aria-controls={'faq-answer-'+i} data-faq-toggle><span>{item.question}</span><span class="faq-toggle-art"><Icon name="plus"/></span></button></h3><div class="faq-answer" id={'faq-answer-'+i} role="region" aria-labelledby={'faq-toggle-'+i} hidden={i!==0}><p>{item.answer}</p></div></article>)}</div></section>

<section class="contact-section" id="contact" aria-labelledby="contact-heading"><div class="container contact-layout">
 <div class="contact-copy"><p class="eyebrow">Обсудим вашу задачу</p><h2 id="contact-heading">Начнём <br/>с вашего <br/>вопроса</h2><p>Расскажите о задаче — предложу подходящий формат работы и первые шаги.</p></div>
 <div class="contact-panel"><h3>Обсудить проект</h3><form id="contact-form" action={'mailto:'+site.email} method="post" enctype="text/plain"><div class="form-grid"><label>Ваше имя <span aria-hidden="true">*</span><input name="name" autocomplete="name" placeholder="Как к вам обращаться" required maxlength="100"/></label><label>Компания<input name="company" autocomplete="organization" placeholder="Название компании" maxlength="180"/></label><label class="form-wide">Рабочая почта <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" placeholder="name@company.ru" required maxlength="254"/></label><label class="form-wide">Что хотите решить?<textarea name="message" rows="3" placeholder="Коротко о вашей задаче" maxlength="3000"></textarea></label></div><label class="consent-label"><input type="checkbox" name="consent" required/><span>Согласен с <button type="button" class="inline-link" data-info="privacy">политикой конфиденциальности</button> и обработкой персональных данных</span></label><button class="button button-yellow form-submit" type="submit">Подготовить письмо <Icon/></button><p class="form-note" id="form-note" aria-live="polite">Отправьте подготовленное письмо через свою почту.</p></form>
 <div class="prepared-message" id="prepared-message" hidden><p>Письмо подготовлено. Данные ещё не отправлены.</p><textarea id="prepared-text" aria-label="Подготовленное письмо" rows="6" readonly></textarea><div><a class="button button-green" id="send-email" href={'mailto:'+site.email}>Открыть в почте <Icon name="mail"/></a><button type="button" class="inline-link" id="copy-email">Скопировать текст</button></div></div><noscript><p class="form-note">Можно написать напрямую: <a href={'mailto:'+site.email}>{site.email}</a>.</p></noscript></div>
</div></section>
</main>
<footer class="footer container"><div class="footer-top"><a class="footer-identity" href="#top"><strong>{site.name}</strong><span>Финансовый директор на аутсорсе</span></a><div class="footer-contacts"><a href={'mailto:'+site.email}><Icon name="mail"/>{site.email}</a><a href={'tel:'+site.phoneHref}><Icon name="phone"/>{site.phone}</a></div></div><div class="footer-bottom"><span>© 2026 Наталья Городицкая</span><button type="button" class="inline-link" data-info="privacy">Политика конфиденциальности</button><a href="#top">Наверх <span aria-hidden="true">↑</span></a></div></footer>

  <dialog class="product-dialog" id="product-dialog" aria-labelledby="product-dialog-heading">
    <button type="button" class="dialog-close" aria-label="Закрыть состав работ"><Icon name="close"/></button>
    <div class="product-dialog-layout" data-tabs>
      <aside class="product-sidebar"><div role="tablist" aria-label="Услуги" aria-orientation="vertical">{products.map((product,i)=><button type="button" role="tab" id={'tab-product-'+product.id} aria-controls={'panel-product-'+product.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-tab={product.id}><Icon name={product.icon}/><span>{product.title}</span></button>)}</div><p>На аутсорсе</p></aside>
      <div class="product-dialog-content"><p class="choose-label" id="product-dialog-heading">Состав работ</p>
        <section role="tabpanel" id="panel-product-finance" aria-labelledby="tab-product-finance" data-panel="finance"><h2>Финансовый директор <br/>на аутсорсе</h2><p class="dialog-intro">Состав подбираем под структуру бизнеса и состояние данных.</p><div class="finance-work-grid">{financeWork.map(item=><div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><p class="dialog-note">Автоматизация 1С, восстановление учёта и сложные проекты оцениваются отдельно.</p><a class="button button-green" href="#contact" data-dialog-contact="Финансовый директор на аутсорсе">Обсудить состав проекта</a></section>
        <section role="tabpanel" id="panel-product-tax" aria-labelledby="tab-product-tax" data-panel="tax" hidden><h2>Налоговый консультант <br/>на аутсорсе</h2><div class="tax-situations">{taxWork.map((item,i)=><details open={i===1} name="tax-situations"><summary>{item.title}<Icon name="plus"/></summary><p>{item.text}</p></details>)}</div><p class="dialog-note">Этапы работы и участие профильного юриста согласуем под задачу.</p><a class="button button-green" href="#contact" data-dialog-contact="Налоговый консультант на аутсорсе">Обсудить налоговую задачу</a></section>
        <section role="tabpanel" id="panel-product-legal" aria-labelledby="tab-product-legal" data-panel="legal" hidden><h2>Юрист компании <br/>на аутсорсе</h2><p class="dialog-intro">Подключаю профильного партнёра под задачу бизнеса.</p><div class="legal-work"><div><Icon name="document"/><h3>Консультации</h3><p>Разбор правового вопроса и документов компании.</p></div><div><Icon name="review"/><h3>Претензионная работа</h3><p>Подготовка позиции и документов по спорной ситуации.</p></div><div><Icon name="legal"/><h3>Судебное сопровождение</h3><p>Согласованный объём работы с профильным юристом.</p></div></div><p class="dialog-note">Состав, исполнитель и стоимость юридических работ согласуются отдельно.</p><a class="button button-green" href="#contact" data-dialog-contact="Юридическая помощь бизнесу">Обсудить правовую задачу</a></section>
      </div>
    </div>
  </dialog>

  <dialog class="info-dialog" id="info-dialog" aria-labelledby="info-heading"><button type="button" class="dialog-close" aria-label="Закрыть подробности"><Icon name="close"/></button><h2 id="info-heading">Подробнее</h2><div id="info-content"></div></dialog>
  <div hidden>{specialTasks.map(task=><section id={'info-'+task.id}><h3>{task.title}</h3><p>{task.detail}</p><a href="#contact" class="button button-green" data-dialog-contact={task.title}>Обсудить задачу</a></section>)}
    <section id="info-privacy"><h3>Конфиденциальность</h3><p>Сайт не получает и не сохраняет данные формы. Введённые сведения используются только в вашем браузере, чтобы подготовить текст письма. Вы самостоятельно отправляете его Наталье через свою почтовую программу.</p><p>Скачивание шаблонов не требует регистрации. Данные компании и доступ к рабочим документам передаются отдельно, после согласования условий сотрудничества.</p><p>Контакт для вопросов: <a href={'mailto:'+site.email}>{site.email}</a>.</p></section>
  </div>

  <script>import '../scripts/main'; import '../scripts/hybrid';</script>
</Layout>

