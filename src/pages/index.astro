---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GrowthMap from '../components/GrowthMap.astro';
import ModelDashboard from '../components/ModelDashboard.astro';
import { site, services, faq } from '../data/site';
const requests = [
 {title:'Прибыль есть,\nа где деньги?',text:'Выручка растёт, но непонятно, куда уходят деньги и почему не чувствуется результат.',icon:'chart'},
 {title:'Команда работает,\nно процессы пробуксовывают',text:'Много ручных операций, разные версии отчётов. Нужны единые правила и понятные роли.',icon:'team'},
 {title:'Хотим масштабироваться,\nно как?',text:'Нужна понятная финансовая модель и план действий: рост, найм и инвестиции без лишних рисков.',icon:'box'},
 {title:'Есть идеи, но не хватает\nструктуры',text:'Хочется навести порядок в цифрах и превратить планы в конкретные шаги и измеримый результат.',icon:'document'},
];
const workflow = [
 {title:'Глубокая\nдиагностика',text:'Разбираемся в текущей ситуации, находим узкие места и точки роста.'},
 {title:'Решение\nи план',text:'Предлагаем варианты, моделируем сценарии и согласовываем план.'},
 {title:'Внедрение\nи поддержка',text:'Помогаем реализовать решения и сопровождаем на всех этапах.'},
 {title:'Измеримый\nрезультат',text:'Фиксируем показатели, оцениваем эффект и строим следующие шаги.'},
];
const projects = [
 {tags:['Производство','2022–2024'],title:'Связать учёт\nи производство',text:'Восстановление учёта, внедрение 1С ERP и подготовка к финансовому due diligence.',detail:'Производственная компания: восстановление учётной базы, внедрение 1С ERP, организация управленческой отчётности и подготовка данных к проверке инвестором.'},
 {tags:['ИТ','2015–2020'],title:'Систематизация\nфинансов проектов',text:'Проектные финансы, восстановление учёта и сопровождение проверок в группе компаний.',detail:'Группа ИТ-компаний: управление проектными финансами, восстановление учёта и сопровождение сложных налоговых проверок.'},
 {tags:['Финансовая модель','Производство'],title:'Видеть бизнес\nна три года вперёд',text:'Финансовая модель производства: связать планы, денежные потоки и результаты.',detail:'В рамках работы в производственной компании разработана финансовая модель на три года для планирования деятельности и подготовки к due diligence.'},
];
---
<Layout>
  <a class="skip-link" href="#main">К содержанию</a>
  <header class="header" id="top"><div class="container header-inner">
    <a class="brand" href="#top" aria-label="Наталья Городицкая — на главную"><span class="brand-name">{site.name}</span><span class="brand-role">Бизнес. Финансы. Системный рост.</span></a>
    <nav class="desktop-nav" aria-label="Основная навигация"><a href="#about">Обо мне</a><a href="#services">Услуги</a><a href="#experience">Кейсы</a><a href="#approach">Подход</a><a href="#expertise">Опыт</a><a href="#contact">Контакты</a></nav>
    <button class="button header-cta" data-open-brief>Обсудить задачу <Icon/></button>
    <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
  </div><nav class="mobile-nav" id="mobile-nav" aria-label="Мобильная навигация" hidden><a href="#about">Обо мне</a><a href="#services">Услуги</a><a href="#experience">Кейсы</a><a href="#approach">Подход</a><a href="#expertise">Опыт</a><a href="#contact">Контакты</a></nav></header>
  <main id="main">
    <section class="hero container">
      <div class="hero-copy"><p class="eyebrow">Консалтинг и финансовое моделирование</p><h1>Видеть бизнес<br/>целиком.<br/>Управлять точнее<span class="lime-dot">.</span></h1><p class="hero-description">Помогаю собственникам и руководителям навести порядок в финансах, процессах и команде, чтобы бизнес рос стабильно и приносил больше свободы.</p><div class="hero-actions"><button class="button" data-open-brief>Обсудить задачу <Icon/></button><a class="text-link" href="#about">Узнать больше <span class="circle-plus"><Icon name="plus"/></span></a></div><div class="hero-facts" id="expertise"><div><strong>с 1996 года</strong><span>в финансах и учёте</span></div><div><strong>50+</strong><span>специалистов в команде</span></div><div><strong>1С ERP</strong><span>опыт внедрения</span></div></div></div>
      <GrowthMap/>
    </section>
    <section class="requests-section" id="tasks"><div class="container split-layout">
      <div class="section-intro"><p class="eyebrow">С чем обращаются</p><h2>Бизнес растёт.<br/>Ясности должно<br/>быть больше.</h2><p>На определённом этапе интуиции и опыта уже недостаточно. Важно видеть системную картину и принимать решения на основе цифр.</p><button class="text-link" data-open-requests>Посмотреть все запросы <span class="circle-plus"><Icon/></span></button></div>
      <div class="request-grid">{requests.map((request,i)=><a class={`request-card request-card-${i+1}`} href="#financial-model"><div class="request-meta"><span>0{i+1}</span><Icon/></div><h3>{request.title}</h3><p>{request.text}</p><Icon name={request.icon} class="request-illustration"/></a>)}</div>
    </div></section>
    <section class="model-section" id="services"><div class="container model-grid" id="financial-model">
      <div class="model-copy"><p class="eyebrow">Инструмент, который работает</p><h2>Ваш бизнес.<br/>В одной модели.</h2><p>Создаём понятную финансовую модель, которая объединяет стратегию, финансы и операционную деятельность. Вы видите, как решения влияют на прибыль, денежный поток и рост.</p><a class="button" href="#model-dashboard">Посмотреть пример <Icon/></a><button class="text-link model-services-link" data-open-services>Услуги и состав работ <Icon/></button></div>
      <ModelDashboard/>
      <ul class="model-benefits"><li><Icon name="finance"/><span>Моделируйте<br/>сценарии</span></li><li><Icon name="shield"/><span>Оценивайте<br/>риски</span></li><li><Icon name="process"/><span>Принимайте<br/>решения<br/>уверенно</span></li></ul>
    </div></section>
    <section class="approach-section" id="approach"><div class="container approach-layout"><div class="section-intro"><p class="eyebrow">Как мы работаем</p><h2>От анализа<br/>к результату.</h2><p>Структурный подход, понятные этапы и постоянная связь на каждом шаге.</p><button class="text-link" data-open-approach>Подробнее о подходе <span class="circle-plus"><Icon/></span></button></div><ol class="workflow">{workflow.map((step,i)=><li><span class="step-number">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>
    <section class="cases-section" id="experience"><div class="container cases-layout"><div class="section-intro"><p class="eyebrow">Практический опыт</p><h2>За решениями<br/>реальный опыт.</h2><p>Учёт, финансовые модели и внедрение систем внутри компаний.</p><button class="text-link" data-open-cases>Все примеры <Icon/></button></div><div class="case-grid">{projects.map((project,i)=><article class="case-card"><div class="case-tags">{project.tags.map(tag=><span>{tag}</span>)}</div><h3>{project.title}</h3><p>{project.text}</p><button class="text-link" data-case={i}>Читать подробнее <Icon/></button></article>)}</div></div></section>
    <section class="about-section" id="about"><div class="container about-grid"><figure class="portrait"><img src="/images/natalia.png" width="327" height="500" alt="Наталья Городицкая" loading="lazy"/><figcaption class="handwritten">Бизнес —<br/>это прежде всего<br/>люди.</figcaption></figure><div class="about-copy"><p class="eyebrow">Обо мне</p><h2>Наталья<br/>Городицкая</h2><p class="about-role">Финансовый директор. Эксперт по учёту.</p><p>С 1996 года помогаю компаниям выстраивать устойчивые финансы. Мой подход — это сочетание аналитики, практического опыта и живого человеческого диалога.</p><button class="text-link" data-open-about>Подробнее обо мне <Icon/></button></div><ul class="about-facts"><li><Icon name="calendar"/><span>Опыт в финансах<br/>и учёте с 1996 года</span></li><li><Icon name="team"/><span>Руководство командой<br/>из 50+ специалистов</span></li><li><Icon name="product"/><span>Опыт в ИТ, производстве<br/>и строительстве</span></li><li><Icon name="certificate"/><span>Фокус на устойчивость<br/>и понятный результат</span></li></ul></div></section>
    <section class="contact-section" id="contact"><img class="contact-landscape" src="/images/consultation-landscape.png" width="2172" height="724" alt="" loading="lazy"/><div class="container contact-grid"><div class="contact-copy"><p class="eyebrow">Консультация</p><h2>Обсудим ваш запрос?</h2><p>Расскажите о задаче, и я предложу возможный формат сотрудничества и первые шаги.</p><div class="contact-actions"><button class="button" data-open-brief>Оставить заявку <Icon/></button><a class="text-link" href={`mailto:${site.email}`}>Написать на почту <span class="circle-plus"><Icon name="mail"/></span></a></div></div><ul class="contact-promises"><li><span><Icon name="document"/></span>Обсуждение задачи</li><li><span><Icon name="shield"/></span>Конфиденциально</li><li><span><Icon name="finance"/></span>Личное ведение проекта</li></ul></div></section>
  </main>
  <footer class="footer"><div class="container footer-inner"><a href="#top" class="brand"><span class="brand-name">{site.name}</span><span class="brand-role">Бизнес. Финансы. Системный рост.</span></a><nav aria-label="Навигация в подвале"><a href="#about">Обо мне</a><a href="#services">Услуги</a><a href="#experience">Кейсы</a><a href="#approach">Подход</a><a href="#expertise">Опыт</a><a href="#contact">Контакты</a></nav><div class="footer-social"><a href={`mailto:${site.email}`} aria-label="Написать Наталье на почту"><Icon name="mail"/></a><a href={`tel:${site.phoneHref}`} aria-label="Позвонить Наталье"><Icon name="phone"/></a></div><div class="footer-legal"><span>© {new Date().getFullYear()} Все права защищены</span><button data-open-privacy>Конфиденциальность</button></div></div></footer>
  <dialog class="info-dialog" id="info-dialog" aria-labelledby="info-title"><button class="dialog-close" aria-label="Закрыть подробности"><Icon name="close"/></button><p class="eyebrow">Наталья Городицкая</p><h2 id="info-title">Подробнее</h2><div id="info-content"></div></dialog>
  <div class="info-sources" hidden>
    <section id="info-services"><h3>Услуги и состав работ</h3><p>Финансовая модель, управленческая отчётность и план-факт — основа для решений собственника.</p>{services.map(service=><article><h4>{service.label}</h4><p>{service.text}</p><ul>{service.bullets.map(item=><li>{item}</li>)}</ul><p>{service.detail}</p></article>)}<article><h4>Сложные контуры</h4><p>Раздельный учёт по ГОЗ, 275-ФЗ, НИОКР и НМА, сопровождение выездных налоговых проверок. Юридические задачи ведём с профильными юристами, подключёнными под проект.</p></article></section>
    <section id="info-requests"><h3>Вопросы собственника</h3><ul><li>Где деньги?</li><li>Почему прибыль есть, а денег нет?</li><li>Выручка растёт, а денег нет.</li><li>Какой проект приносит прибыль?</li><li>Могу ли я принять в штат сотрудников?</li><li>Почему не дают кредит?</li><li>Почему банк заблокировал выборку кредита?</li></ul><p>Переводим эти вопросы в понятные цифры, финансовую модель и оперативные управленческие отчёты.</p></section>
    <section id="info-approach"><h3>От диагностики к решениям</h3>{workflow.map(step=><article><h4>{step.title}</h4><p>{step.text}</p></article>)}<p>Наталья ведёт проект лично. Интеграторы 1С, налоговые юристы и другие специалисты подключаются под согласованную задачу.</p></section>
    <section id="info-about"><h3>Финансы, учёт и развитие</h3><p>Опыт Натальи соединяет финансовое управление, бухгалтерский учёт и внедрение систем. Финансовая модель опирается на данные компании, а отчёты учитывают её процессы.</p><p>ИТ, производство и строительство. Восстановление учёта, 1С ERP, проектные финансы и подготовка к due diligence.</p>{faq.map(item=><article><h4>{item.question}</h4><p>{item.answer}</p></article>)}<p>Связаться: <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p></section>
    <section id="info-cases"><h3>Примеры из практики</h3>{projects.map(project=><article><h4>{project.title}</h4><p>{project.detail}</p></article>)}</section>
    {projects.map((project,i)=><section id={`info-case-${i}`}><h3>{project.title}</h3><p>{project.detail}</p><p>Подробнее о задаче и применимости подхода можно обсудить на встрече.</p></section>)}
    <section id="info-privacy"><h3>Как работает сайт</h3><p>Этот сайт не получает и не сохраняет данные, введённые в форму. Текст письма формируется в вашем браузере и остаётся у вас, пока вы сами не отправите его Наталье через свою почтовую программу.</p><p>Контакты для связи: {site.email}, {site.phone}.</p></section>
  </div>
  <script>
    const infoDialog=document.getElementById('info-dialog') as HTMLDialogElement;
    const showInfo=(id:string)=>{const source=document.getElementById('info-'+id);if(!source)return;document.getElementById('info-title')!.textContent=source.querySelector('h3')!.textContent;const content=document.getElementById('info-content')!;content.replaceChildren(...[...source.children].filter(el=>el.tagName!=='H3').map(el=>el.cloneNode(true)));infoDialog.showModal();};
    ['services','requests','approach','about','cases','privacy'].forEach(id=>document.querySelector('[data-open-'+id+']')?.addEventListener('click',()=>showInfo(id)));
    document.querySelectorAll('[data-case]').forEach(el=>el.addEventListener('click',()=>showInfo('case-'+(el as HTMLElement).dataset.case)));
    infoDialog.querySelector('.dialog-close')?.addEventListener('click',()=>infoDialog.close());
    infoDialog.addEventListener('click',e=>{if(e.target!==infoDialog)return;const r=infoDialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)infoDialog.close();});
  </script>
  <dialog class="brief-dialog" id="brief-dialog" aria-labelledby="brief-title">
    <button class="dialog-close" aria-label="Закрыть окно"><Icon name="close" /></button>
    <p class="eyebrow">Начало разговора</p><h2 id="brief-title">Расскажите<br />о вашей задаче<span class="lime-dot">.</span></h2>
    <p class="dialog-intro">Подготовим текст письма Наталье. Вы сможете скопировать его или открыть в своей почтовой программе.</p>
    <form id="brief-form">
      <label>Как вас зовут<input name="name" autocomplete="name" required maxlength="100" placeholder="Имя и фамилия" /></label>
      <label>Компания<input name="company" autocomplete="organization" required maxlength="150" placeholder="Название и сфера деятельности" /></label>
      <label>Задача<select name="task"><option>Финансовая модель и управленческая отчётность</option><option>Учёт и отчётность</option><option>НИОКР и нематериальные активы</option><option>Автоматизация на базе 1С</option><option>Банковское финансирование</option><option>Раздельный учёт по ГОЗ</option><option>Налоговая проверка</option><option>Другая задача</option></select></label>
      <label>Что важно решить<textarea name="message" rows="3" maxlength="3000" placeholder="Кратко опишите ситуацию и желаемый результат"></textarea></label>
      <button class="button" type="submit">Подготовить письмо <Icon /></button>
      <p class="form-note" id="form-note" aria-live="polite">Данные не сохраняются на сайте.</p>
    </form>
    <a class="dialog-email" href={`mailto:${site.email}`}>Или напишите напрямую: {site.email}</a>
    <div class="email-fallback" hidden><p>Текст готов. Скопируйте его и отправьте Наталье или откройте письмо в почтовой программе.</p><textarea id="prepared-email" aria-label="Текст подготовленного письма" rows="5" readonly></textarea><div class="prepared-actions"><button class="text-link" id="copy-brief">Скопировать текст <Icon /></button><a class="text-link" id="send-prepared-email" href={`mailto:${site.email}`}>Открыть в почте <Icon /></a></div></div>
  </dialog>
  <script define:vars={{ email: site.email }}>
    const toggle = document.querySelector('.menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label','Открыть меню'); if (mobileNav) mobileNav.hidden = true; };
    toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню'); mobileNav.hidden = !open; });
    mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click',closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
    window.matchMedia('(min-width: 1101px)').addEventListener('change',closeMenu);
    const dialog = document.getElementById('brief-dialog');
    const form = document.getElementById('brief-form');
    document.querySelectorAll('[data-open-brief]').forEach(button => button.addEventListener('click', () => {
      const task = button.dataset.task;
      if (task) { const select=form.elements.task; const option=[...select.options].find(o=>o.value.toLowerCase()===task.toLowerCase()); if(option)select.value=option.value; }
      dialog.showModal();
    }));
    dialog.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
    dialog?.addEventListener('click', e => { if (e.target === dialog) { const r=dialog.getBoundingClientRect(); if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close(); } });
    dialog?.addEventListener('close',()=> { document.querySelector('.email-fallback').hidden=true; document.getElementById('form-note').textContent='Данные не сохраняются на сайте.'; form.reset(); });
    form?.addEventListener('submit', e => {
      e.preventDefault();
      const data=new FormData(form);
      const subject=`Обсуждение проекта: ${data.get('company')}`;
      const body=`Наталья, добрый день!\n\nМеня зовут ${data.get('name')}.\nКомпания: ${data.get('company')}.\nЗадача: ${data.get('task')}.\n\n${data.get('message') || ''}\n\nХочу обсудить возможный состав работ и формат сотрудничества.`;
      document.getElementById('prepared-email').value=body;
      document.querySelector('.email-fallback').hidden=false;
      document.getElementById('form-note').textContent='Текст письма подготовлен. Данные ещё не отправлены.';
      document.getElementById('send-prepared-email').href=`mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      document.getElementById('prepared-email').focus();
    });
    document.getElementById('copy-brief')?.addEventListener('click',async () => { const field=document.getElementById('prepared-email'); try { await navigator.clipboard.writeText(field.value); document.getElementById('form-note').textContent='Текст скопирован. Вставьте его в письмо Наталье.'; } catch { field.focus(); field.select(); document.getElementById('form-note').textContent='Выделенный текст можно скопировать вручную.'; } });
  </script>
</Layout>
