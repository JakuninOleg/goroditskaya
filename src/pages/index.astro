---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FinancialReport from '../components/FinancialReport.astro';
import { site, questions, products, financeWork, taxWork, formats, specialTasks, faq } from '../data/site';
const previews = [
  { title: 'ДДС на 13 недель', icon: 'ledgers', headers: ['Неделя','Поступления','Выплаты','Остаток'], count: 13 },
  { title: 'Прибыль по проектам', icon: 'report', headers: ['Проект','Доходы','Расходы','Прибыль','Маржа'], count: 9 },
  { title: 'План-факт бюджета', icon: 'chart', headers: ['Статья','План','Факт','Отклонение'], count: 13 },
];
const featuredQuestions = [
  { index: 0, icon: 'cash', note: 'Понятно, куда уходит денежный поток' },
  { index: 1, icon: 'costs', note: 'Находим причины нехватки денег' },
  { index: 2, icon: 'report', note: 'Видно результат каждого проекта' },
  { index: 8, icon: 'tax', note: 'Разбираем документы и риски' },
];
---
<Layout>
  <a class="skip-link" href="#main">К содержанию</a>
  <header class="masthead" id="top">
    <div class="masthead-shell">
      <div class="masthead-row">
      <a class="identity" href="#top" aria-label="Наталья Городицкая — на главную"><span class="identity-name">Наталья<span class="identity-break"></span> Городицкая</span><span class="identity-role">Финансовый директор <span class="identity-role-ending">на аутсорсе</span></span></a>
      <nav class="masthead-nav" aria-label="Основная навигация"><a href="#about">Обо мне</a><a href="#services">Услуги</a><a href="#experience">Кейс</a><a href="#approach">Как работаем</a></nav>
      <a class="button button-yellow masthead-cta" href="#contact">Обсудить задачу <Icon/></a>
      <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span><span></span></button>
      </div>
      <nav class="masthead-mobile-nav" id="mobile-nav" aria-label="Мобильная навигация" hidden><a href="#tasks">Задачи</a><a href="#services">Услуги</a><a href="#experience">Кейс</a><a href="#approach">Как работаем</a><a href="#about">Обо мне</a><a href="#faq">Вопросы и ответы</a><a href="#contact">Контакты</a></nav>
    </div>
  </header>
  <div class="masthead-scrim" aria-hidden="true" hidden></div>

  <main id="main">
    <section class="intro" aria-labelledby="hero-heading">
      <div class="intro-stage">
      <div class="intro-container intro-copy"><div class="intro-text">
          <h1 id="hero-heading"><span>Видеть бизнес</span><span>целиком.</span><span>Управлять точнее.</span></h1>
          <p class="intro-description">Помогаю собственникам навести порядок <br class="intro-break"/>в финансах, видеть реальную прибыль <br class="intro-break"/>и принимать решения на основе цифр.</p>
          <a class="button button-yellow intro-cta" href="#contact">Обсудить задачу <Icon/></a>
      </div></div>
      <picture class="intro-visual"><img src="/images/natalia-office.webp" srcset="/images/natalia-office-960.webp 960w, /images/natalia-office.webp 1672w" sizes="(max-width: 950px) 100vw, 75vw" width="1672" height="941" alt="Наталья Городицкая" fetchpriority="high" decoding="async"/></picture>
      </div>
      <div class="intro-container intro-facts-wrap"><div class="intro-facts">
        <div class="intro-fact"><Icon name="verified"/><div class="intro-fact-copy"><strong>С {site.experienceSince} года</strong><span>в финансах и учёте</span></div></div>
        <div class="intro-fact"><Icon name="automation"/><div class="intro-fact-copy"><strong>1С ERP</strong><span>внедрение и сопровождение</span></div></div>
        <div class="intro-fact"><Icon name="remote"/><div class="intro-fact-copy"><strong>Вся Россия</strong><span>работаю удалённо</span></div></div>
      </div></div>
    </section>

    <section class="section container iceberg-section" id="tasks" aria-labelledby="tasks-heading">
      <div class="iceberg-intro">
        <p class="section-kicker">Проблема</p><h2 id="tasks-heading">Ваш вопрос — <br/>вершина айсберга</h2>
        <p>За конкретным запросом часто скрываются более глубокие финансовые причины. Они влияют на прибыль и развитие бизнеса.</p>
        <a class="button button-yellow" href="#contact">Разобрать ситуацию <Icon/></a>
      </div>
      <div class="iceberg-visual" id="iceberg-answer" aria-live="polite" aria-atomic="true">
        <img src="/images/iceberg.webp" width="1448" height="1086" alt="" loading="lazy" decoding="async"/>
        <h3 class="sr-only" data-iceberg-headline>{questions[0].headline}</h3>
        <div class="iceberg-callout iceberg-visible"><strong>Видимая часть</strong><p>Выручка, прибыль, налоги</p></div>
        <div class="iceberg-callout iceberg-hidden"><strong>Что под поверхностью</strong><ul data-iceberg-checks>{questions[0].checks.map(check=><li>{check}</li>)}</ul></div>
        <p class="iceberg-explanation" data-iceberg-explanation>{questions[0].explanation}</p>
      </div>
      <div class="iceberg-choices"><div class="question-list" role="group" aria-label="Вопросы собственника">{featuredQuestions.map(q=><button class="question-card" type="button" data-question={q.index} aria-pressed={q.index===0?'true':'false'} aria-controls="iceberg-answer"><Icon name={q.icon}/><span><strong>{questions[q.index].title}</strong><small>{q.note}</small></span></button>)}</div><details class="more-questions"><summary>Другие вопросы <Icon name="plus"/></summary><div>{questions.map((q,i)=>!featuredQuestions.some(f=>f.index===i)&&<button type="button" data-question={i} aria-pressed="false" aria-controls="iceberg-answer">{q.title}</button>)}</div></details></div>
    </section>

    <section class="section container products-section" id="services" aria-labelledby="products-heading">
      <div class="section-title-row"><div><p class="section-kicker">Услуги</p><h2 id="products-heading">Три направления<br/>работы</h2></div><a class="text-link" href="#contact">Подобрать формат <Icon/></a></div>
      <div class="products-list">{products.map(product=>
        <article class={'product-row product-'+product.id}>
          <Icon name={product.icon} class="product-icon"/>
          <div class="product-copy"><h3>{product.title}<br/>на аутсорсе</h3><p>{product.text}</p></div>
          <button class="product-button text-link" type="button" data-product={product.id} aria-haspopup="dialog">Подробнее <Icon/><span class="sr-only">: {product.title}</span></button>
        </article>
      )}</div>
    </section>

    <FinancialReport/>

    <section class="section container technored-section" id="experience" aria-labelledby="case-heading">
      <div class="case-story"><p class="section-kicker">Кейс · Технорэд</p><h2 id="case-heading">Разработки, <br/>которые были <br/>скрыты в расходах</h2><p class="case-description">Учёт разработок помог показать активы бизнеса и подготовить финансовую картину для инвесторов.</p></div>
      <div class="case-feature"><strong>62 млн ₽</strong><p>затрат отнесены к НИОКР</p><ul class="case-assets"><li><Icon name="research"/>Новая технология</li><li><Icon name="patent"/>Патент на полезную модель</li><li><Icon name="verified"/>Патент на изобретение</li></ul></div>
      <div class="case-detail"><div><h3>Проблема</h3><p>Затраты на разработки включались в расходы периода. Команде не хватало опыта оформления НИОКР и НМА.</p></div><div><h3>Решение</h3><p>Проанализированы затраты и документы. 62 млн ₽ выделены в составе НИОКР с положительным результатом.</p></div><div><h3>Результат</h3><p>Новая технология и патенты отражены как активы. Финансовая картина стала полнее для инвесторов.</p></div></div>
      <div class="case-snapshots"><div><h3 class="eyebrow">6 месяцев</h3><p><strong>80 млн ₽</strong> — выручка</p><p><strong>50 млн ₽</strong> — накопленный убыток</p></div><div><h3 class="eyebrow">9 месяцев</h3><p><strong>140 млн ₽</strong> — выручка</p><p><strong>11 млн ₽</strong> — прибыль</p></div></div>
      <p class="case-note">Данные Натальи Городицкой. Периоды разной длительности; год и вид прибыли уточняются.<br/>Выделение НИОКР — изменение учёта, а не поступление денег.</p>
    </section>

    <section class="section container formats-section" id="approach" aria-labelledby="formats-heading" data-tabs>
      <div class="formats-intro"><p class="section-kicker">Процесс</p><h2 id="formats-heading">Как можем <br/>работать</h2></div><div class="formats-main">
      <div class="format-tabs" role="tablist" aria-label="Форматы работы">{formats.map((format,i)=><button type="button" role="tab" id={'tab-'+format.id} aria-controls={'panel-'+format.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-tab={format.id}>{format.label}</button>)}</div>
      {formats.map((format,i)=><div class="format-panel" role="tabpanel" id={'panel-'+format.id} aria-labelledby={'tab-'+format.id} data-panel={format.id} hidden={i!==0} tabindex="0">
        <div class="format-copy"><h3>{format.title}</h3><p class="format-description">{format.text}</p></div>
        <div class="format-results">{format.items.map(item=><div><Icon name="check"/><p>{item.title}</p></div>)}</div>
        <a class="button button-yellow" href="#contact" data-task={format.label}>{format.action} <Icon/></a>
        <p class="format-note">Состав работ и стоимость согласуем до начала.</p>
      </div>)}</div>
      <div class="project-journey"><h3>Путь проекта</h3><ol>{['Задача','План','Внедрение','Контроль'].map(step=><li><span aria-hidden="true"></span>{step}</li>)}</ol></div>
    </section>

    <section class="section container special-section" aria-labelledby="special-heading">
      <div class="special-intro"><p class="section-kicker">Задачи</p><h2 id="special-heading">Для сложных <br/>задач</h2><p class="section-description">Когда стандартных инструментов недостаточно, подключаю профильных специалистов.</p></div>
      <div class="special-grid">{specialTasks.map(task=><button class="special-task" type="button" data-info={task.id} aria-haspopup="dialog"><Icon name={task.icon}/><h3>{task.title}</h3><p>{task.text}</p><span class="sr-only">Подробнее</span></button>)}</div>
    </section>

    <section class="section container about-section" id="about" aria-labelledby="about-heading">
      <div class="about-portrait"><img src="/images/natalia-editorial.webp" width="1120" height="1400" alt="Наталья Городицкая за рабочим столом" loading="lazy" decoding="async"/></div>
      <div class="about-copy"><p class="section-kicker">Обо мне</p><h2 id="about-heading">Лично веду ваш проект</h2><p class="about-name">Наталья Городицкая</p><p class="about-lead">Помогаю собственникам навести порядок в финансах и принимать решения на основе цифр.</p>
        <ul class="about-facts" id="expertise"><li>В финансах и учёте с {site.experienceSince} года</li><li>Опыт руководства командой 50+ специалистов</li><li>Опыт внедрения 1С ERP</li></ul>
        <p class="about-partners">Специалистов 1С и юриста подключаю под задачу.</p>
        <div class="practice" data-tabs><p class="choose-label">Из практики</p><div class="practice-tabs" role="tablist" aria-label="Отрасли практики"><button type="button" role="tab" id="tab-production" aria-controls="panel-production" aria-selected="true" data-tab="production">Производство</button><button type="button" role="tab" id="tab-it" aria-controls="panel-it" aria-selected="false" tabindex="-1" data-tab="it">IT и SaaS</button></div>
          <div role="tabpanel" id="panel-production" aria-labelledby="tab-production" data-panel="production"><h3>Восстановление учёта и ERP</h3><p>Проектный учёт и финансовая подготовка к due diligence.</p></div>
          <div role="tabpanel" id="panel-it" aria-labelledby="tab-it" data-panel="it" hidden><h3>Финансы проектов и НМА</h3><p>Управленческая отчётность, план-факт и учёт разработок.</p></div>
        </div>
        <a class="button button-yellow" href="#contact">Обсудить задачу <Icon/></a>
      </div><aside class="about-principles"><h3>Мой подход</h3><ul><li><Icon name="check"/>Понятные отчёты без сложных терминов</li><li><Icon name="check"/>Решения с учётом целей собственника</li><li><Icon name="check"/>Конфиденциальность рабочих данных</li><li><Icon name="check"/>Личное ведение проекта</li></ul></aside>
    </section>

    <section class="section container resources-section" aria-labelledby="resources-heading">
      <div class="resources-panel">
        <div class="resources-copy"><h2 id="resources-heading">Начните <br/>с понятных <br/>форм.</h2><p>Excel-шаблоны <br/>и краткая инструкция.</p><a class="button button-yellow" href="/downloads/financial-templates.xlsx" download>Получить комплект<span class="sr-only"> — Excel, три формы</span></a></div>
        <div class="sheet-previews">{previews.map((preview,i)=><article class="sheet-preview"><div class="sheet-title"><h3>{preview.title}</h3><Icon name={preview.icon}/></div><span class="sample-label">Образец</span><div class={'sheet-grid cols-'+preview.headers.length} aria-hidden="true">{preview.headers.map(header=><span class="sheet-cell sheet-cell-head">{header}</span>)}{Array.from({length:preview.count*preview.headers.length},(_,n)=><span class="sheet-cell">{i===0&&n%preview.headers.length===0?Math.floor(n/preview.headers.length)+1:''}</span>)}<span class="sheet-total">Итого</span></div>{i===1&&<div class="sheet-mini-chart" aria-hidden="true">{[28,46,62,77,100].map(height=><i style={'height:'+height+'%'}></i>)}</div>}</article>)}</div>
      </div>
    </section>

    <section class="section container contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="faq-column" id="faq"><p class="section-kicker">Вопросы и ответы</p><h2 id="contact-heading">Начнём с<br/>вашего вопроса</h2><div class="faq-list">{faq.map((item,i)=><details open={i===0} name="faq"><summary>{item.question}<Icon name="plus"/></summary><p>{item.answer}</p></details>)}</div></div>
      <div class="contact-panel"><h3>Обсудить проект</h3>
        <form id="contact-form" action={'mailto:'+site.email} method="post" enctype="text/plain">
          <label>Ваше имя <span aria-hidden="true">*</span><input name="name" autocomplete="name" required maxlength="100"/></label>
          <label>Компания<input name="company" autocomplete="organization" maxlength="180"/></label>
          <label>Рабочая почта <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="254"/></label>
          <label>Что хотите решить?<textarea name="message" rows="3" maxlength="3000"></textarea></label>
          <label class="consent-label"><input type="checkbox" name="consent" required/><span>Согласен с <button type="button" class="inline-link" data-info="privacy">политикой конфиденциальности</button> и обработкой персональных данных</span></label>
          <button class="button button-yellow" type="submit">Подготовить письмо</button>
          <p class="form-note" id="form-note" aria-live="polite">Текст останется у вас. Отправьте его через свою почту.</p>
        </form>
        <div class="prepared-message" id="prepared-message" hidden><p>Письмо подготовлено. Данные ещё не отправлены.</p><textarea id="prepared-text" aria-label="Подготовленное письмо" rows="6" readonly></textarea><div><a class="button button-yellow" id="send-email" href={'mailto:'+site.email}>Открыть в почте</a><button type="button" class="inline-link" id="copy-email">Скопировать текст</button></div></div>
        <noscript><p class="form-note">Можно написать напрямую: <a href={'mailto:'+site.email}>{site.email}</a>.</p></noscript>
      </div>
    </section>
  </main>

  <footer class="footer container"><a class="footer-name" href="#top">{site.name}</a><a href={'mailto:'+site.email}>{site.email}</a><a href={'tel:'+site.phoneHref}>{site.phone}</a><span>© {new Date().getFullYear()}</span><button type="button" class="inline-link" data-info="privacy">Политика конфиденциальности</button></footer>

  <dialog class="product-dialog" id="product-dialog" aria-labelledby="product-dialog-heading">
    <button type="button" class="dialog-close" aria-label="Закрыть состав работ"><Icon name="close"/></button>
    <div class="product-dialog-layout" data-tabs>
      <aside class="product-sidebar"><div role="tablist" aria-label="Услуги" aria-orientation="vertical">{products.map((product,i)=><button type="button" role="tab" id={'tab-product-'+product.id} aria-controls={'panel-product-'+product.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-tab={product.id}><Icon name={product.icon}/><span>{product.title}</span></button>)}</div><p>На аутсорсе</p></aside>
      <div class="product-dialog-content"><p class="choose-label" id="product-dialog-heading">Состав работ</p>
        <section role="tabpanel" id="panel-product-finance" aria-labelledby="tab-product-finance" data-panel="finance"><h2>Финансовый директор<br/>на аутсорсе</h2><p class="dialog-intro">Состав подбираем под структуру бизнеса и состояние данных.</p><div class="finance-work-grid">{financeWork.map(item=><div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><p class="dialog-note">Автоматизация 1С, восстановление учёта и сложные проекты оцениваются отдельно.</p><a class="button button-green" href="#contact" data-dialog-contact="Финансовый директор на аутсорсе">Обсудить состав проекта</a></section>
        <section role="tabpanel" id="panel-product-tax" aria-labelledby="tab-product-tax" data-panel="tax" hidden><h2>Налоговый консультант<br/>на аутсорсе</h2><div class="tax-situations">{taxWork.map((item,i)=><details open={i===1} name="tax-situations"><summary>{item.title}<Icon name="plus"/></summary><p>{item.text}</p></details>)}</div><p class="dialog-note">Этапы работы и участие профильного юриста согласуем под задачу.</p><a class="button button-green" href="#contact" data-dialog-contact="Налоговый консультант на аутсорсе">Обсудить налоговую задачу</a></section>
        <section role="tabpanel" id="panel-product-legal" aria-labelledby="tab-product-legal" data-panel="legal" hidden><h2>Юрист компании<br/>на аутсорсе</h2><p class="dialog-intro">Подключаю профильного партнёра под задачу бизнеса.</p><div class="legal-work"><div><Icon name="document"/><h3>Консультации</h3><p>Разбор правового вопроса и документов компании.</p></div><div><Icon name="review"/><h3>Претензионная работа</h3><p>Подготовка позиции и документов по спорной ситуации.</p></div><div><Icon name="legal"/><h3>Судебное сопровождение</h3><p>Согласованный объём работы с профильным юристом.</p></div></div><p class="dialog-note">Состав, исполнитель и стоимость юридических работ согласуются отдельно.</p><a class="button button-green" href="#contact" data-dialog-contact="Юридическая помощь бизнесу">Обсудить правовую задачу</a></section>
      </div>
    </div>
  </dialog>

  <dialog class="info-dialog" id="info-dialog" aria-labelledby="info-heading"><button type="button" class="dialog-close" aria-label="Закрыть подробности"><Icon name="close"/></button><h2 id="info-heading">Подробнее</h2><div id="info-content"></div></dialog>
  <div hidden>{specialTasks.map(task=><section id={'info-'+task.id}><h3>{task.title}</h3><p>{task.detail}</p><a href="#contact" class="button button-green" data-dialog-contact={task.title}>Обсудить задачу</a></section>)}
    <section id="info-privacy"><h3>Конфиденциальность</h3><p>Сайт не получает и не сохраняет данные формы. Введённые сведения используются только в вашем браузере, чтобы подготовить текст письма. Вы самостоятельно отправляете его Наталье через свою почтовую программу.</p><p>Скачивание шаблонов не требует регистрации. Данные компании и доступ к рабочим документам передаются отдельно, после согласования условий сотрудничества.</p><p>Контакт для вопросов: <a href={'mailto:'+site.email}>{site.email}</a>.</p></section>
  </div>

  <script>import '../scripts/main';</script>
</Layout>

