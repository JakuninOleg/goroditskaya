---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Emblem from '../components/Emblem.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactForm from '../components/ContactForm.astro';
import { productSlugs, serviceHref } from '../data/services';
import FinancialReport from '../components/FinancialReport.astro';
import Iceberg from '../components/Iceberg.astro';
import CaseIllustration from '../components/CaseIllustration.astro';
import ExpertWorkbench from '../components/ExpertWorkbench.astro';
import { site, products, formats, faq } from '../data/site';
const processIcons = ['review','system','clarity'];
const processPages = ['finansovaya-diagnostika','upravlencheskiy-uchet-proizvodstva','finansovyy-direktor-na-autsorse'];
const processDescriptions = ['Проверяю данные, нахожу причины и определяю первые изменения.','Связываю учёт, финансовую модель, бюджет и отчётность.','Разбираю отклонения, обновляю прогноз и работаю с командой.'];
const templates = [
 { title:'ДДС на 13 недель', label:'Денежный поток', headers:['Неделя','Приход','Расход','Остаток'],rows:[['01','120','80','40'],['02','180','140','80'],['03','160','130','110']],bars:[32,46,40,60,54,76,68,88],type:'cash'},
 { title:'Прибыль по проектам', label:'Результат направлений', headers:['Проект','Доход','Затраты','Прибыль'],rows:[['А','120','85','35'],['Б','180','140','40'],['В','160','110','50']],bars:[58,72,64,85,76,100],type:'profit'},
 { title:'План-факт бюджета', label:'Контроль отклонений',headers:['Статья','План','Факт','Разница'],rows:[['Доход','150','160','+10'],['Затраты','100','105','+5'],['Прибыль','50','55','+5']],bars:[66,60,86,78,56,64,96,88],type:'budget'}
];
---
<Layout>
<a class="skip-link" href="#main">К содержанию</a>
<SiteHeader/>
<main id="main">
<section class="hero" aria-labelledby="hero-heading">
 <div class="hero-stage">
  <picture class="hero-visual"><source media="(max-width:640px)" srcset="/images/hybrid/hero-mobile-desktop-companion-v8.webp"/><source media="(max-width:1180px)" srcset="/images/hybrid/hero-sunlit-tablet-v3-1200.webp 1200w, /images/hybrid/hero-sunlit-tablet-v3.webp 1536w" sizes="100vw"/><img src="/images/hybrid/hero-sunlit-v3.webp" srcset="/images/hybrid/hero-sunlit-v3-1200.webp 1200w, /images/hybrid/hero-sunlit-v3.webp 2170w" sizes="100vw" width="2170" height="725" alt="Наталья Городицкая за рабочим столом" fetchpriority="high" decoding="async"/></picture>
  <div class="container hero-copy"><div class="hero-text"><h1 id="hero-heading"><span>Видеть бизнес</span><span>целиком.</span><span>Управлять <em>точнее.</em></span></h1><p class="hero-description"><span class="hero-description-full">Помогаю собственникам навести порядок в финансах, видеть прибыль и принимать решения на основе цифр.</span><span class="hero-description-mobile">Порядок в финансах. Решения на основе цифр.</span></p><a class="button button-yellow hero-cta" href="#contact">Обсудить задачу <Icon/></a></div></div>
 </div>
 <div class="container hero-facts"><div class="hero-fact"><Emblem name="experience"/><div><strong>С {site.experienceSince} года</strong><span class="fact-full">в финансах и учёте</span><span class="fact-short">в финансах</span></div></div><div class="hero-fact"><Emblem name="system"/><div><strong>1С ERP</strong><span class="fact-full">внедрение и сопровождение</span><span class="fact-short">внедрение</span></div></div><div class="hero-fact"><Emblem name="remote"/><div><strong>Вся Россия</strong><span class="fact-full">работаю удалённо</span><span class="fact-short">удалённо</span></div></div></div>
</section>

<Iceberg/>

<section class="section container products-section" id="services" aria-labelledby="products-heading">
 <div class="section-heading"><p class="eyebrow">Экспертиза для вашего бизнеса</p><h2 id="products-heading">Три направления работы</h2></div>
 <div class="products-list">{products.map(product=><article class={'product-card product-'+product.id}><Emblem name={product.id==='finance'?'clarity':product.id==='tax'?'tax':'legal'} class="product-emblem"/><div class="product-copy"><h3>{product.title} <span>на аутсорсе</span></h3><p>{product.text}</p><a class="product-button text-link" href={serviceHref(productSlugs[product.id])}>Состав работ <Icon/><span class="sr-only">: {product.title}</span></a></div></article>)}</div>
 <p class="products-note"><span></span>Профильных специалистов подключаю под задачу вашего проекта.</p>
</section>

<FinancialReport/>

<section class="section case-section" id="experience" aria-labelledby="case-heading"><div class="container">
 <div class="case-intro"><div class="case-copy"><p class="eyebrow">Кейс · НИОКР и НМА</p><h2 id="case-heading">Разработки, которые стали активами</h2><p class="case-amount"><span>62</span> млн ₽</p><p class="case-amount-label">затрат отнесены к НИОКР</p><a class="text-link" href="/kejsy/niokr-62-mln/">Разбор кейса <Icon/></a></div><div class="case-art"><CaseIllustration/></div></div>
 <div class="case-steps">
  <article class="case-step"><span class="step-number">01</span><h3>Проблема</h3><p>Затраты на разработки списывались в расходы. Финансовый результат не отражал созданную технологию.</p><Emblem name="document" class="case-step-emblem"/></article>
  <article class="case-step case-step-solution"><span class="step-number">02</span><h3>Решение</h3><p>Проанализировала затраты и документы. Выделила 62 млн ₽ затрат на результативные НИОКР.</p><Emblem name="clarity" class="case-step-emblem"/></article>
  <article class="case-step case-step-result"><span class="step-number">03</span><h3>Результат</h3><p>Технология и патенты отражены как активы. Инвесторы получили более полную финансовую картину.</p><strong class="case-conclusion">Созданные активы стали видны инвесторам.</strong></article>
 </div>
</div></section>

<section class="section container process-section" id="approach" aria-labelledby="formats-heading">
 <div class="section-heading"><p class="eyebrow">От первого вопроса до рабочей системы</p><h2 id="formats-heading">Как я работаю</h2></div>
 <div class="process-grid">{formats.map((format,i)=><article class="process-card"><div class="process-card-title"><Emblem name={processIcons[i]}/><h3>{format.label}</h3></div><p class="process-description">{processDescriptions[i]}</p><ul class="process-outputs">{format.items.map(item=><li><Icon name="check"/>{item.title}</li>)}</ul><a class="text-link" href={serviceHref(processPages[i])}>Подробнее о формате <Icon/><span class="sr-only">: {format.label}</span></a></article>)}</div>
</section>

<ExpertWorkbench/>

<section class="section container about-section" id="about" aria-labelledby="about-heading">
 <div class="about-portrait"><img src="/images/hybrid/about-natalia-v2.webp" srcset="/images/hybrid/about-natalia-v2-640.webp 640w, /images/hybrid/about-natalia-v2.webp 1120w" sizes="(max-width:640px) 90vw, 40vw" width="1120" height="1400" alt="Наталья Городицкая" loading="lazy" decoding="async"/></div>
 <div class="about-copy"><h2 id="about-heading">Лично веду <br/>ваш проект</h2><p class="about-name">Наталья Городицкая</p><p class="about-lead">Соединяю финансовую модель, учёт и задачи собственника. Подключаю профильных специалистов под проект.</p><div class="about-facts" id="expertise"><div><Emblem name="experience"/><p><strong>С {site.experienceSince} года</strong><span>в финансах и учёте</span></p></div><div><Emblem name="system"/><p><strong>1С ERP</strong><span>внедрение и сопровождение</span></p></div><div><Emblem name="team"/><p><strong>Руководила командой</strong><span>из более чем 50 специалистов</span></p></div></div><div class="about-principles"><div><Emblem name="clarity"/><span>Понятные отчёты</span></div><div><Emblem name="secure"/><span>Конфиденциальность</span></div><div><Emblem name="personal"/><span>Личное ведение</span></div></div><a class="text-link" href="#contact">Обсудить ваш проект <Icon/></a></div>
</section>

<section class="section resources-section" id="resources" aria-labelledby="resources-heading"><div class="container">
 <div class="resources-copy"><p class="eyebrow">Инструменты собственника</p><h2 id="resources-heading">Начните с понятных форм</h2><p class="resources-lead">Три Excel-шаблона для контроля денег, проектов и бюджета. Укажите почту и телефон, чтобы получить комплект.</p><ul class="resource-benefits"><li><Emblem name="clarity"/><div><strong>Планируйте денежный поток</strong><span>Поступления, платежи и остаток на 13 недель.</span></div></li><li><Emblem name="profit"/><div><strong>Оценивайте прибыль проектов</strong><span>Доходы, затраты и результат по направлениям.</span></div></li><li><Emblem name="tax"/><div><strong>Контролируйте бюджет</strong><span>План, факт и отклонения по статьям.</span></div></li></ul><form id="templates-form" action={'mailto:'+site.email} method="post" enctype="text/plain"><div class="templates-contact-fields"><label for="templates-email">Рабочая почта <span aria-hidden="true">*</span><input id="templates-email" name="email" type="email" autocomplete="email" placeholder="name@company.ru" maxlength="254" required/></label><label for="templates-phone">Телефон <span aria-hidden="true">*</span><input id="templates-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" maxlength="18" required/></label></div><label class="consent-label"><input type="checkbox" name="consent" required/><span>Согласен с <button type="button" class="inline-link" data-privacy-open>политикой обработки персональных данных</button></span></label><button class="button button-yellow" type="submit">Получить формы на почту <Icon/></button></form><span class="resources-file-note">Excel · формулы и инструкция внутри</span></div>
 <div class="template-scene">{templates.map((template,i)=><article class={'template-holder template-'+template.type}><div class="template-sheet"><div class="template-file"><span><Icon name="document"/> XLSX</span><span>{'0'+(i+1)}</span></div><h3>{template.title}</h3><p>{template.label}</p><table class="template-table" aria-label={'Образец: '+template.title}><thead><tr>{template.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{template.rows.map(row=><tr>{row.map((value,n)=>n===0?<th scope="row">{value}</th>:<td>{value}</td>)}</tr>)}</tbody></table><div class="template-chart" aria-hidden="true">{template.bars.map((v,n)=><span style={'--bar:'+v+'%;--i:'+n}></span>)}</div><div class="template-sheet-footer"><span>Рабочая форма</span><Emblem name="document"/></div></div><span class="glass-holder" aria-hidden="true"></span></article>)}</div>
</div></section>

<section class="section container faq-section" id="faq" aria-labelledby="faq-heading"><div class="faq-intro"><p class="eyebrow">Перед началом работы</p><h2 id="faq-heading">Ответы <br/>на частые <br/>вопросы</h2><div class="faq-desk-art" aria-hidden="true"><Emblem name="document"/><Emblem name="secure"/></div></div><div class="faq-list">{faq.map((item,i)=><article class="faq-item" data-faq-item><h3><button type="button" id={'faq-toggle-'+i} aria-expanded={i===0?'true':'false'} aria-controls={'faq-answer-'+i} data-faq-toggle><span>{item.question}</span><span class="faq-toggle-art"><Icon name="plus"/></span></button></h3><div class="faq-answer" id={'faq-answer-'+i} role="region" aria-labelledby={'faq-toggle-'+i} hidden={i!==0}><p>{item.answer}</p></div></article>)}</div></section>

<section class="contact-section" id="contact" aria-labelledby="contact-heading"><div class="container contact-layout">
 <div class="contact-copy"><p class="eyebrow">Обсудим вашу задачу</p><h2 id="contact-heading">Начнём <br/>с вашего <br/>вопроса</h2><p>Расскажите о задаче — предложу подходящий формат работы и первые шаги.</p></div>
 <ContactForm/>
</div></section>
</main>
<SiteFooter/>

  <script>import '../scripts/main'; import '../scripts/hybrid';</script>
</Layout>

