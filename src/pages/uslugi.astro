---
import PageLayout from '../layouts/PageLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import PageCta from '../components/PageCta.astro';
import { services,serviceHref } from '../data/services';
const categories=[{title:'Финансовое управление',icon:'clarity',text:'Диагностика, финансовые модели и постоянная работа с отчётностью, бюджетом и платежами.'},{title:'Учёт и системы',icon:'system',text:'Постановка учёта, расчёт себестоимости, настройка 1С и восстановление базы.'},{title:'Налоги и право',icon:'tax',text:'Документы, позиция компании и профильные специалисты для требований, проверок и споров.'}];
---
<PageLayout title="Услуги для собственников бизнеса" description="Финансовый директор, налоговое и юридическое сопровождение, постановка управленческого учёта, 1С, финансирование, ГОЗ и НИОКР. Услуги Натальи Городицкой.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Услуги'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><p class="eyebrow">От вопроса собственника к рабочей системе</p><h1>Финансовые услуги для собственников бизнеса</h1><p class="inner-lead">Лично веду финансовые проекты среднего и крупного бизнеса. Для технических и правовых задач подключаю профильных специалистов. Выберите нужное направление — или начнём с диагностики.</p><div class="inner-actions"><a class="button button-yellow" href="/uslugi/finansovaya-diagnostika/">С чего начать <Icon/></a><a class="text-link" href="#request">Обсудить задачу <Icon/></a></div></div><HeroArtwork name="catalog" caption="Финансы, учёт и сопровождение решений"/></div></div></section>
  {categories.map(category=><section class="inner-section container catalog-section"><div class="section-intro"><div class="catalog-heading"><Emblem name={category.icon}/><h2>{category.title}</h2></div><p>{category.text}</p></div><div class="catalog-grid">{services.filter(s=>s.category===category.title).map(s=><a class="catalog-card" href={serviceHref(s.slug)}><Emblem name={s.emblem}/><h3>{s.title}</h3><p>{s.question}</p><span class="text-link">Подробнее об услуге <Icon/></span></a>)}</div></section>)}
  <PageCta title="Не знаете, с какой услуги начать?" text="Расскажите, какой вопрос сейчас важнее всего. Помогу понять, что проверить первым и какая услуга подойдёт."/>
</PageLayout>
