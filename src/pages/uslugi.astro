---
import PageLayout from '../layouts/PageLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import PageCta from '../components/PageCta.astro';
import { services,serviceHref } from '../data/services';
import { serviceGroups } from '../data/service-groups';
import { primaryOrigin } from '../data/seo';
const structuredData=[{'@context':'https://schema.org','@type':'ItemList','@id':primaryOrigin+'/uslugi/#services',name:'Подробные страницы услуг команды',numberOfItems:services.length,mainEntityOfPage:{'@id':primaryOrigin+'/uslugi/#webpage'},itemListElement:services.map((service,index)=>({'@type':'ListItem',position:index+1,name:service.title,url:new URL(serviceHref(service.slug),primaryOrigin).href}))}];
---
<PageLayout title="Услуги для собственников бизнеса" description="Бухгалтерский и налоговый учёт, ВЭД и комплаенс по льготным режимам. Финансовое управление, налоговая безопасность и юридическая помощь вашему бизнесу." structuredData={structuredData}>
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Услуги'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><h1>Учёт, финансы и защита вашего бизнеса</h1><p class="inner-lead">Четыре направления работы команды «Городицкая и партнёры». Подберём специалиста под вашу отрасль и задачу: от восстановления учёта до финансового управления, налоговых проверок и юридической помощи.</p><div class="inner-actions"><a class="button button-yellow" href="#request">Получить консультацию <Icon/></a><a class="text-link" href="#accounting">Выбрать направление <Icon/></a></div></div><HeroArtwork name="catalog" caption="Финансы, учёт и сопровождение решений"/></div></div></section>
  <nav class="container catalog-directions" aria-label="Направления услуг">{serviceGroups.map(group=><a class="text-link" href={'#'+group.id}>{group.title}<Icon/></a>)}</nav>
  {serviceGroups.map(group=><section class="inner-section container catalog-section" id={group.id} aria-labelledby={group.id+'-heading'}>
    <div class="section-intro"><div class="catalog-heading"><Emblem name={group.emblem}/><h2 id={group.id+'-heading'}>{group.title}</h2></div>{group.description&&<p>{group.description}</p>}</div>
    <p class="catalog-product-count">{group.products.length} {group.products.length===3?'услуги':'услуг'} в направлении</p>
    <ol class="subproduct-grid">{group.products.map((product,index)=><li><span class="subproduct-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{product.title}</h3><p>{product.text}</p></div></li>)}</ol>
    <div class="catalog-detail-links"><p>Подробнее об услугах</p><div>{group.services.map(slug=>services.find(service=>service.slug===slug)!).map(service=><a class="text-link" href={serviceHref(service.slug)}>{service.title}<Icon/></a>)}</div></div>
  </section>)}
  <PageCta title="Подберём услугу под вашу задачу" text="Оставьте контакт и кратко опишите ситуацию. Свяжемся с вами и определим состав работ."/>
</PageLayout>
<style>
  .catalog-directions{display:flex;flex-wrap:wrap;gap:18px 32px;padding-block:30px;border-bottom:1px solid var(--line)}
  .catalog-directions a{font-size:16px;max-width:100%}
  .catalog-product-count{margin-top:28px;color:#496354;font-size:14px}
  .subproduct-grid{list-style:none;padding:0;margin:22px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:0 40px}
  .subproduct-grid li{display:grid;grid-template-columns:34px minmax(0,1fr);gap:16px;padding:26px 0 30px;border-top:1px solid #bdcbb8;min-width:0}
  .subproduct-number{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#e2e8d6;color:#496354;font-size:12px;font-variant-numeric:tabular-nums}
  .subproduct-grid h3{font:600 22px/1.35 var(--sans);letter-spacing:-.025em;text-wrap:pretty}
  .subproduct-grid p{font-size:16px;line-height:1.7;color:#405b50;margin-top:12px;max-width:58ch}
  .catalog-detail-links{display:grid;grid-template-columns:1fr 2fr;gap:32px;margin-top:20px;padding-top:28px;border-top:1px solid var(--line)}
  .catalog-detail-links>p{font-size:18px;font-weight:500}
  .catalog-detail-links>div{display:flex;flex-wrap:wrap;align-items:start;gap:16px 28px}
  .catalog-detail-links .text-link{font-size:15px;line-height:1.6;max-width:100%;gap:12px}
  @media(max-width:700px){.catalog-directions{flex-direction:column;align-items:start;gap:16px}.subproduct-grid{grid-template-columns:1fr}.subproduct-grid li{padding:22px 0 25px;gap:12px}.subproduct-grid h3{font-size:21px}.catalog-detail-links{grid-template-columns:1fr;gap:20px}}
</style>
