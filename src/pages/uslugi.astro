---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import PageCta from '../components/PageCta.astro';
import { services,serviceHref } from '../data/services';
const categories=[{title:'Финансовое управление',icon:'clarity',text:'От первого разбора цифр до регулярной работы с бюджетом, денежным потоком и решениями собственника.'},{title:'Учёт и системы',icon:'system',text:'Методология, данные и процессы, на которых держатся управленческая и бухгалтерская отчётность.'},{title:'Налоги и право',icon:'tax',text:'Документы, позиция компании и профильные специалисты для требований, проверок и споров.'}];
---
<PageLayout title="Услуги для собственников бизнеса" description="Финансовый директор, налоговое и юридическое сопровождение, постановка управленческого учёта, 1С, финансирование, ГОЗ и НИОКР. Услуги Натальи Городицкой.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Услуги'}]}/><div class="catalog-intro"><p class="eyebrow">От вопроса собственника к рабочей системе</p><h1>Финансы, в которых можно разобраться</h1><p class="inner-lead">Лично веду финансовые проекты среднего и крупного бизнеса. Для технических и правовых задач подключаю профильных специалистов. Выберите нужное направление — или начнём с диагностики.</p><div class="inner-actions"><a class="button button-yellow" href="/uslugi/finansovaya-diagnostika/">С чего начать <Icon/></a><a class="text-link" href="#request">Обсудить задачу <Icon/></a></div></div></div></section>
  {categories.map(category=><section class="inner-section container catalog-section"><div class="section-intro"><div class="catalog-heading"><Emblem name={category.icon}/><h2>{category.title}</h2></div><p>{category.text}</p></div><div class="catalog-grid">{services.filter(s=>s.category===category.title).map(s=><a class="catalog-card" href={serviceHref(s.slug)}><Emblem name={s.emblem}/><h3>{s.title}</h3><p>{s.question}</p><span class="text-link">Подробнее об услуге <Icon/></span></a>)}</div></section>)}
  <PageCta title="Не знаете, с какой услуги начать?" text="Расскажите, какой вопрос сейчас важнее всего. Помогу определить периметр разбора и следующий шаг."/>
</PageLayout>
