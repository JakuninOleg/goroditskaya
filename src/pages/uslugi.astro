---
import PageLayout from '../layouts/PageLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import PageCta from '../components/PageCta.astro';
import { services,serviceHref } from '../data/services';
import { serviceGroups } from '../data/service-groups';
---
<PageLayout title="Услуги для собственников бизнеса" description="Бухгалтерский учёт и отчётность, финансовое управление, налоговая безопасность и юридическая помощь. Услуги команды Натальи Городицкой по всей России.">
  <section class="inner-hero"><div class="container"><Breadcrumbs items={[{label:'Услуги'}]}/><div class="inner-hero-grid"><div class="catalog-intro"><h1>Учёт, финансы и защита бизнеса</h1><p class="inner-lead">Четыре направления работы команды «Городицкая и партнёры». Подберём специалиста под вашу отрасль и задачу: от восстановления учёта до финансового управления, налоговых проверок и юридической помощи.</p><div class="inner-actions"><a class="button button-yellow" href="#request">Получить консультацию <Icon/></a><a class="text-link" href="#accounting">Выбрать направление <Icon/></a></div></div><HeroArtwork name="catalog" caption="Финансы, учёт и сопровождение решений"/></div></div></section>
  <nav class="container catalog-directions" aria-label="Направления услуг">{serviceGroups.map(group=><a class="text-link" href={'#'+group.id}>{group.title}<Icon/></a>)}</nav>
  {serviceGroups.map(group=><section class="inner-section container catalog-section" id={group.id} aria-labelledby={group.id+'-heading'}>
    <div class="section-intro"><div class="catalog-heading"><Emblem name={group.emblem}/><h2 id={group.id+'-heading'}>{group.title}</h2></div><p>{group.description}</p></div>
    <div class="catalog-grid">{group.services.map(slug=>services.find(service=>service.slug===slug)!).map(service=><a class="catalog-card" href={serviceHref(service.slug)}><Emblem name={service.emblem}/><h3>{service.title}</h3><p>{service.question}</p><span class="text-link">Подробнее об услуге <Icon/></span></a>)}</div>
    <div class="catalog-work"><h3>Также в этом направлении</h3><ul>{group.details.map(detail=><li><Icon name="check"/><span>{detail}</span></li>)}</ul></div>
  </section>)}
  <PageCta title="Подберём услугу под вашу задачу" text="Оставьте контакт и кратко опишите ситуацию. Свяжемся с вами и определим состав работ."/>
</PageLayout>
<style>
  .catalog-directions{display:flex;flex-wrap:wrap;gap:18px 32px;padding-block:30px;border-bottom:1px solid var(--line)}
  .catalog-directions a{font-size:16px;max-width:100%}
  .catalog-work{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:32px;margin-top:32px;padding-top:28px;border-top:1px solid var(--line)}
  .catalog-work h3{font-family:var(--sans);font-size:22px;line-height:1.35}
  .catalog-work ul{list-style:none;padding:0;margin:0;display:grid;gap:16px}
  .catalog-work li{display:flex;align-items:start;gap:12px;font-size:17px;line-height:1.65;color:#405b50}
  .catalog-work li :global(svg){flex-shrink:0;width:18px;height:18px;margin-top:5px;color:#527e67}
  @media(max-width:700px){.catalog-directions{flex-direction:column;align-items:start;gap:16px}.catalog-work{grid-template-columns:1fr;gap:20px}.catalog-work li{font-size:16px}}
</style>
