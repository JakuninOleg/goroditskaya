---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import PageCta from '../../components/PageCta.astro';
import CaseIllustration from '../../components/CaseIllustration.astro';
import Faq from '../../components/Faq.astro';
import Emblem from '../../components/Emblem.astro';
import Icon from '../../components/Icon.astro';
import { services, serviceHref, type Service } from '../../data/services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
interface Props { service:Service; }
const { service }=Astro.props;
const related=service.related.map(slug=>services.find(s=>s.slug===slug)!).filter(Boolean);
const contact='#request';
const origin=Astro.site!;
const breadcrumbs=[{label:'Услуги',href:'/uslugi/'},{label:service.short}];
const structuredData=[
 {'@context':'https://schema.org','@type':'Service',name:service.title,description:service.description,url:new URL(serviceHref(service.slug),origin).href,provider:{'@type':'Person',name:'Наталья Городицкая',url:new URL('/o-natale/',origin).href},areaServed:{'@type':'Country',name:'Россия'}},
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Главная',item:new URL('/',origin).href},{name:'Услуги',item:new URL('/uslugi/',origin).href},{name:service.short,item:new URL(serviceHref(service.slug),origin).href}].map((item,i)=>({'@type':'ListItem',position:i+1,...item}))}
];
---
<PageLayout title={service.title} description={service.description} structuredData={structuredData}>
  <section class="inner-hero"><div class="container"><Breadcrumbs items={breadcrumbs}/><div class="inner-hero-grid"><div>
    <p class="eyebrow">{service.category}</p><h1>{service.title}</h1><p class="inner-lead">{service.lead}</p>
    <div class="inner-actions"><a class="button button-yellow" href={contact}>Обсудить задачу <Icon/></a><a class="text-link" href="#scope">Что входит в работу <Icon/></a></div>
    <div class="inner-meta"><span>С 2003 года в финансах</span><span>По всей России</span></div>
  </div><ServiceVisual service={service}/></div></div></section>
  <section class="inner-section situation-section"><div class="container"><p class="eyebrow">Когда обращаться</p><h2>В каких ситуациях это поможет</h2><div class="situation-grid">{service.situations.map((s,i)=><article><span class="situation-number">{'0'+(i+1)}</span><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></section>
  <section class="inner-section container" id="scope"><div class="scope-layout"><div class="scope-intro"><p class="eyebrow">Содержание проекта</p><h2>Что входит в работу</h2><p>Периметр согласуем по задаче бизнеса, состоянию данных и роли вашей команды.</p></div><div class="scope-list">{service.scope.map(s=><article><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></section>
  <section class="inner-section deliverables"><div class="container"><p class="eyebrow">Что получите</p><h2>{service.result}</h2><div class="deliverables-grid">{service.deliverables.map((s,i)=><article><Emblem name={i===0?'document':i===1?service.emblem:'review'}/><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></section>
  <section class="inner-section service-workflow" id="work-process" aria-labelledby="workflow-heading"><div class="container">
    <h2 id="workflow-heading">Как строится работа</h2>
    <div class="service-workflow-layout">
      <ol class="service-steps">{service.steps.map((s,i)=><li>
        <span class="step-index" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
        <div class="service-step-copy"><h3>{s.title}</h3><p>{s.text}</p></div>
      </li>)}</ol>
      <aside class="workflow-aside" aria-label="Подготовка к работе">
        <div class="workflow-preparation"><div class="workflow-preparation-heading"><Emblem name="document"/><h3>Что обсудим на старте</h3></div>
          <ul>{service.inputs.map(item=><li><Icon name="check"/><span>{item}</span></li>)}</ul>
        </div>
        <div class="workflow-boundary"><h3>Состав и границы проекта</h3><p>{service.boundary}</p></div>
      </aside>
    </div>
  </div></section>
  {service.case&&<section class="inner-section situation-section"><div class="container case-feature"><div><p class="eyebrow">Из практики</p><h2>Разработки, которые стали активами</h2><p class="case-amount">62 млн ₽</p><p>После анализа затраты на результативные НИОКР были выделены из расходов. Созданная технология и патенты стали видны в составе активов компании.</p><a class="text-link" href="/kejsy/niokr-62-mln/">Проблема, решение и результат <Icon/></a></div><div class="case-art"><CaseIllustration/></div></div></section>}
  <section class="inner-section container"><div class="service-faq"><div><p class="eyebrow">Перед началом</p><h2>Вопросы по услуге</h2></div><Faq items={service.faq}/></div>{service.source&&<p class="service-source">По теме: <a href={service.source.url} target="_blank" rel="noopener noreferrer">{service.source.title}</a></p>}</section>
  <section class="inner-section container related-section"><p class="eyebrow">Следующий шаг</p><h2>Связанные задачи</h2><div class="related-grid">{related.map(s=><a class="related-card" href={serviceHref(s.slug)}><Emblem name={s.emblem}/><h3>{s.short}</h3><p>{s.question}</p><span class="related-arrow">Подробнее <Icon/></span></a>)}</div></section>
  <PageCta service={service.title}/>
</PageLayout>
